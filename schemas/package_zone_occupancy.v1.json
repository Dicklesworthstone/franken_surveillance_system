{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/package_zone_occupancy.v1.json",
  "title": "FSS source-verified sampled class occupancy v1",
  "description": "Complete frame-major/zone-minor counts of actual confirmed inside assignments from a retained native package-zone report. Zero is no positive observation, never absence. Null means privacy or source-health policy withholds the count. This projection creates no new retention, event or effect authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "observation_kind",
    "report_digest",
    "policy_generation",
    "policy_digest",
    "source",
    "configuration",
    "frames",
    "samples",
    "semantics",
    "coverage_witness",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "fss.package_zone_occupancy.v1"
    },
    "operation": {
      "const": "read_verified"
    },
    "observation_kind": {
      "const": "sampled_class_occupancy"
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    },
    "policy_generation": {
      "const": 1
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "sensor_id",
        "zone_report",
        "zone_provenance_root",
        "analysis_digest",
        "detection_report",
        "import_identity",
        "import_root",
        "package_digest",
        "model_id",
        "model_generation",
        "model_digest",
        "contract_digest",
        "label",
        "class_index",
        "capture_time_label",
        "clock_basis",
        "privacy_binding",
        "health_screening_required"
      ],
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "zone_report": {
          "$ref": "#/$defs/digest"
        },
        "zone_provenance_root": {
          "$ref": "#/$defs/digest"
        },
        "analysis_digest": {
          "$ref": "#/$defs/digest"
        },
        "detection_report": {
          "$ref": "#/$defs/digest"
        },
        "import_identity": {
          "$ref": "#/$defs/digest"
        },
        "import_root": {
          "$ref": "#/$defs/digest"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "model_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "model_digest": {
          "$ref": "#/$defs/digest"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "class_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "capture_time_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "clock_basis": {
          "enum": [
            "utc_disciplined",
            "device_monotonic",
            "host_monotonic",
            "estimated"
          ]
        },
        "privacy_binding": {
          "$ref": "#/$defs/digest"
        },
        "health_screening_required": {
          "type": "boolean"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_hits",
        "maximum_missed_frames",
        "minimum_iou_ppm",
        "zones"
      ],
      "properties": {
        "confirmation_hits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "maximum_missed_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minimum_iou_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/zone"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_report_retained",
        "current_source_revalidated",
        "absence_certified",
        "continuous_occupancy_established",
        "population_bound_established",
        "person_identity_established",
        "current_camera_health_established",
        "detection_quality_qualified",
        "canonical_event_revision",
        "effect_authorized"
      ],
      "properties": {
        "source_report_retained": {
          "const": true
        },
        "current_source_revalidated": {
          "const": true
        },
        "absence_certified": {
          "const": false
        },
        "continuous_occupancy_established": {
          "const": false
        },
        "population_bound_established": {
          "const": false
        },
        "person_identity_established": {
          "const": false
        },
        "current_camera_health_established": {
          "const": false
        },
        "detection_quality_qualified": {
          "const": false
        },
        "canonical_event_revision": {
          "const": false
        },
        "effect_authorized": {
          "const": false
        }
      }
    },
    "coverage_witness": {
      "type": "null"
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signedNanoseconds": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest_ns",
        "latest_ns"
      ],
      "properties": {
        "earliest_ns": {
          "$ref": "#/$defs/signedNanoseconds"
        },
        "latest_ns": {
          "$ref": "#/$defs/signedNanoseconds"
        }
      }
    },
    "zoneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height",
        "margin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/zoneId"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "margin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment",
        "capsule_digest",
        "capture",
        "dimensions",
        "time_reliable",
        "source_boundary"
      ],
      "properties": {
        "segment": {
          "type": "integer",
          "minimum": 0
        },
        "capsule_digest": {
          "$ref": "#/$defs/digest"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "minItems": 2,
          "maxItems": 2
        },
        "time_reliable": {
          "type": "boolean"
        },
        "source_boundary": {
          "type": "boolean"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "zone",
        "state",
        "observed_count",
        "health",
        "confirmed_outside",
        "excluded",
        "supporting_tracks"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "zone": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "state": {
          "enum": [
            "observed_positive",
            "no_positive_observation",
            "masked",
            "health_excluded"
          ]
        },
        "observed_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "enum": [
            "unassessed",
            "screened_without_findings",
            "no_matching_diagnostic",
            "screening_incomplete",
            "findings"
          ]
        },
        "confirmed_outside": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tentative",
            "boundary",
            "partial",
            "unobserved",
            "masked",
            "health"
          ],
          "properties": {
            "tentative": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "boundary": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "partial": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "unobserved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "masked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "health": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            }
          }
        },
        "supporting_tracks": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed_positive"
              }
            }
          },
          "then": {
            "properties": {
              "observed_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              },
              "supporting_tracks": {
                "minItems": 1
              },
              "health": {
                "enum": [
                  "unassessed",
                  "screened_without_findings"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "no_positive_observation"
              }
            }
          },
          "then": {
            "properties": {
              "observed_count": {
                "const": 0
              },
              "supporting_tracks": {
                "maxItems": 0
              },
              "health": {
                "enum": [
                  "unassessed",
                  "screened_without_findings"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "masked",
                  "health_excluded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_count": {
                "type": "null"
              },
              "supporting_tracks": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "health_excluded"
              }
            }
          },
          "then": {
            "properties": {
              "health": {
                "enum": [
                  "no_matching_diagnostic",
                  "screening_incomplete",
                  "findings"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "health": {
                "enum": [
                  "no_matching_diagnostic",
                  "screening_incomplete",
                  "findings"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "masked",
                  "health_excluded"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
