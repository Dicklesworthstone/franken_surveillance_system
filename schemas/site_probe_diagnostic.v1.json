{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/site_probe_diagnostic.v1.json",
  "title": "FSS native site probe refusal",
  "description": "Payload-free refusal for an unapproved or failed single-source probe. Connection/credential attempt metadata is explicit. A remote session may survive local closure after uncertain SETUP or lost TEARDOWN acknowledgement. Refusal never emits a successful receipt or retries a camera.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "error_id",
    "exit_id",
    "exit_code",
    "connection_attempted",
    "credential_access_attempted",
    "remote_session_may_exist",
    "teardown_acknowledged",
    "source_retained",
    "receipt_issued",
    "retry_automatically"
  ],
  "properties": {
    "schema": {
      "const": "fss.site_probe_diagnostic.v1"
    },
    "status": {
      "const": "refused"
    },
    "error_id": {
      "type": "string",
      "pattern": "^ERR-[A-Z0-9-]+$",
      "maxLength": 128
    },
    "exit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "exit_code": {
      "enum": [
        1,
        2
      ]
    },
    "connection_attempted": {
      "type": "boolean"
    },
    "credential_access_attempted": {
      "type": "boolean"
    },
    "remote_session_may_exist": {
      "type": "boolean"
    },
    "teardown_acknowledged": {
      "type": "boolean"
    },
    "source_retained": {
      "const": false
    },
    "receipt_issued": {
      "const": false
    },
    "retry_automatically": {
      "const": false
    },
    "clock_contact_attempted": {
      "const": true
    }
  }
}
