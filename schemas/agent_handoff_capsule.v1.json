{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/agent_handoff_capsule.v1.json",
  "title": "Agent Handoff Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoffId",
    "missionId",
    "sourceSessionId",
    "sourcePrincipalId",
    "anchor",
    "situationFingerprint",
    "objective",
    "criteria",
    "budgets",
    "symbolTableGeneration",
    "activeInvestigations",
    "findings",
    "assumptions",
    "invalidatedAssumptions",
    "activePlans",
    "preparedOperations",
    "tasks",
    "leases",
    "obligations",
    "indeterminateEffects",
    "recommendedAffordances",
    "compressionReceiptId",
    "createdAtNs",
    "expiresAtNs",
    "contractBasis",
    "handoffRoot",
    "childRoots",
    "situationCapsuleRoot",
    "recipientScope",
    "privacyGenerationId",
    "retentionClass",
    "deletionClosureId",
    "resumePolicy",
    "publicationReceiptId"
  ],
  "properties": {
    "schema": {
      "const": "fss.agent_handoff_capsule.v1"
    },
    "handoffId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "sourceSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "sourcePrincipalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "targetPrincipalHint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "anchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "situationFingerprint": {
      "$ref": "sensor_capsule.v1.json#/$defs/digest"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "failure",
        "stop"
      ],
      "properties": {
        "success": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "failure": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "stop": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "deadlineNs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencyMs",
        "tokens",
        "bytes",
        "modelCalls",
        "cpuMillis",
        "acceleratorMillis",
        "energyMilliJoules",
        "networkBytes",
        "storageOperations",
        "privacyExposure",
        "operatorAttentionSeconds"
      ],
      "properties": {
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "cpuMillis": {
          "type": "integer",
          "minimum": 0
        },
        "acceleratorMillis": {
          "type": "integer",
          "minimum": 0
        },
        "energyMilliJoules": {
          "type": "integer",
          "minimum": 0
        },
        "networkBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageOperations": {
          "type": "integer",
          "minimum": 0
        },
        "privacyExposure": {
          "type": "number",
          "minimum": 0
        },
        "operatorAttentionSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "title": "Budget vector"
    },
    "symbolTableGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "symbols": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "objectId"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^@[a-z][0-9]{1,6}$"
          },
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          }
        }
      }
    },
    "activeInvestigations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statementId",
          "text",
          "epistemicState",
          "basis"
        ],
        "properties": {
          "statementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "basis": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "contradictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "validUntilNs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "invalidatedAssumptions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "rejectedPaths": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "activePlans": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "preparedOperations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "leases": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "obligations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "indeterminateEffects": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "branches": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "decisionImpactDeltaId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendedAffordances": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "proofPointers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "requiredCapabilityProjection": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "compressionReceiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAtNs": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAtNs": {
      "type": "integer",
      "minimum": 0
    },
    "contractBasis": {
      "$ref": "agent_contract_basis.v1.json"
    },
    "handoffRoot": {
      "$ref": "sensor_capsule.v1.json#/$defs/digest"
    },
    "childRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "sensor_capsule.v1.json#/$defs/digest"
      }
    },
    "situationCapsuleRoot": {
      "$ref": "sensor_capsule.v1.json#/$defs/digest"
    },
    "recipientScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPrincipals",
        "requiredCapabilities",
        "purpose"
      ],
      "properties": {
        "allowedPrincipals": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^CAP-[A-Z0-9-]+-[0-9]{3}$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "privacyGenerationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "retentionClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deletionClosureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "resumePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rebaseRequired",
        "invalidators",
        "minimumSemanticProtocol",
        "expiredAction"
      ],
      "properties": {
        "rebaseRequired": {
          "type": "boolean"
        },
        "invalidators": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "minimumSemanticProtocol": {
          "const": "fss/1"
        },
        "expiredAction": {
          "enum": [
            "refuse",
            "orient_from_live_state",
            "operator_review"
          ]
        }
      }
    },
    "publicationReceiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    }
  }
}
