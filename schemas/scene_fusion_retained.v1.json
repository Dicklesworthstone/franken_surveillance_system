{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/scene_fusion_retained.v1.json",
  "title": "Retained scene reconstruction with complete custody and assumptions",
  "description": "Complete report bounded to 8 MiB including newline. report_digest is SHA-256 over the exact UTF-8 report member before the terminal newline. Source owner revalidation precedes release. Native source validity, geometric semantics, digest equality and cross-row relationships require the corresponding owners; JSON Schema shape validation is not authentication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_digest",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_fusion_retained.v1"
    },
    "report_digest": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "authority",
        "source_provenance",
        "physical_identity_established",
        "input_document_digest",
        "projection_digest",
        "anchor_digest",
        "anchor",
        "bindings",
        "declarations",
        "track_aliases",
        "geometry",
        "assumptions"
      ],
      "properties": {
        "schema": {
          "const": "fss.scene_fusion_retained.v1"
        },
        "outcome": {
          "enum": [
            "complete",
            "complete_with_refusals"
          ]
        },
        "authority": {
          "const": "derived_cognition_no_effect_authority"
        },
        "source_provenance": {
          "const": "verified_retained_package_observations"
        },
        "physical_identity_established": {
          "const": false
        },
        "input_document_digest": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
        },
        "projection_digest": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
        },
        "anchor_digest": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
        },
        "anchor": {
          "$ref": "scene_handoffs_retained.v1.json#/$defs/anchor"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "scene_handoffs_retained.v1.json#/$defs/binding"
          }
        },
        "declarations": {
          "$ref": "scene_fusion_retained_query.v1.json"
        },
        "track_aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selection",
              "track",
              "camera",
              "exposure_recipe"
            ],
            "properties": {
              "selection": {
                "$ref": "scene_handoffs_query.v1.json#/$defs/id"
              },
              "track": {
                "$ref": "scene_fusion_retained_query.v1.json#/$defs/identity"
              },
              "camera": {
                "$ref": "scene_fusion_retained_query.v1.json#/$defs/identity"
              },
              "exposure_recipe": {
                "const": "retained_segment_plus_one"
              }
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report_digest",
            "report"
          ],
          "properties": {
            "report_digest": {
              "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
            },
            "report": {
              "type": "object",
              "required": [
                "schema",
                "outcome",
                "basis",
                "assumptions",
                "cameras",
                "hypotheses",
                "counts",
                "work"
              ],
              "properties": {
                "schema": {
                  "const": "fss.scene_fusion_report.v1"
                },
                "outcome": {
                  "enum": [
                    "complete",
                    "complete_with_refusals"
                  ]
                },
                "hypotheses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "outcome",
                      "knowledge",
                      "observations",
                      "estimate"
                    ]
                  }
                }
              },
              "description": "Complete native scene report emitted by the existing scene-fusion owner. Its source-custody and timing fields name the enclosing retained owner. No fields are removed or rewritten by the wrapper."
            }
          }
        },
        "assumptions": {
          "const": [
            "rig_camera_placements_and_source_to_rig_mapping_are_operator_declarations",
            "source_pixels_are_assumed_to_match_the_declared_undistorted_image_domain",
            "clock_offsets_and_common_clock_are_operator_declarations",
            "feature_rectangles_and_cross_camera_correspondence_are_operator_declarations",
            "source_custody_does_not_establish_detector_accuracy_or_physical_identity",
            "geometric_covariance_covers_only_declared_independent_pixel_noise"
          ]
        }
      }
    }
  }
}
