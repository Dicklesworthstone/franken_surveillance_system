            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "receive_clock": {
          "$ref": "http_capture_sentinel.v1.json#/$defs/digest"
        },
        "retention_evidence": {
          "$ref": "http_capture_sentinel.v1.json#/$defs/digest"
        },
        "after_complete": {
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/capture_limits"
        },
        "reserved_reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "reserved_wire_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "reserved_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "policy": {
          "const": "explicit-generations:fixed-slot-reservations:root-before-parse:verified-boundary-before-next-connect:native-retry-policy:one-deadline:framing-only:v1"
        },
        "writes": {
          "const": "none"
        },
        "network": {
          "const": "none"
        },
        "retention": {
          "const": "original_headers_and_media_local_unencrypted"
        },
        "capture_time": {
          "const": "unknown_receive_clock_only"
        },
        "coverage_certified": {
          "const": false
        },
        "wire_recovery": {
          "const": "save_key_before_publication_no_capture_resume"
        },
        "durable_history": {
          "$ref": "http_capture_sentinel.v1.json#/$defs/durable_history"
        },
        "storage_drain": {
          "$ref": "http_capture_sentinel.v1.json#/$defs/storage_drain"
        }
      },
      "description": "Exact ordinary native capture preview admitted by the prefix profile. Exactly one generation, a positive explicit stop_after_frames_or_zero, and durable-history capability are mandatory. A requested stop is not an ended-history boundary. Native capture decode is forbidden. Optional original-wire recovery and storage-only drain keep their existing closed projection.",
      "allOf": [
        {
          "if": {
            "required": [
              "storage_drain"
            ]
          },
          "then": {
            "required": [
              "wire_recovery"
            ],
            "properties": {
              "limits": {
                "required": [
                  "storage_only_grace_ns"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "limits": {
                "not": {
                  "required": [
                    "storage_only_grace_ns"
                  ]
                }
              }
            }
          }
        }
      ]
    },
