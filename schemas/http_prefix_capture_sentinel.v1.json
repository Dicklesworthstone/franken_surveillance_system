        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9.\\[\\]:-]+$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/(?!/)[A-Za-z0-9/._~-]*$"
        },
