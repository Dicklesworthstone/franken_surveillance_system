{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/http_prefix_capture_sentinel.v1.json",
  "title": "Approved live HTTP original-prefix capture to retained native detector analysis",
  "description": "Bounded parent JSONL projection for one approved HTTP generation stopped at an explicit acknowledged frame count, followed by source-closed native detector analysis of only those first N frames. All newly introduced wrapper records are closed. Exact existing capture, scalar and resource projections are reused; the embedded native report keeps the established native-owned projection boundary. Each parent line validates independently, while interleaved capture lines retain their native format. Native owners enforce original/read-ahead custody, approval and command identity, first-N arithmetic, current authority/privacy, path separation, monotonic resource accounting and complete output limits. Neither this JSON shape nor a requested stop asserts EOF, ended history, continuous coverage, absence, event authority or automatic reacquisition.",
  "type": "object",
  "required": [
    "format",
    "kind"
  ],
  "properties": {
    "format": {
      "const": "fss.http_prefix_capture_sentinel.v1"
    },
    "kind": {
      "enum": [
        "plan",
        "capture_ready",
        "prefix_ready",
        "imported",
        "completed",
        "capture_incomplete",
        "analysis_failed"
      ]
    }
  },
  "$defs": {
