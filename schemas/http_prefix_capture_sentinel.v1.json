        "wire_bytes_per_slot",
        "entity_bytes_per_slot",
        "multipart_header_bytes",
        "multipart_wrapper_bytes",
        "frame_bytes",
        "read_bytes",
        "frames_per_slot",
        "native_frames_with_lookahead",
        "source_runs",
        "io_calls_per_slot",
        "connect_timeout_ns",
        "reads_per_slot",
        "scan_roots",
        "spool_object_bytes",
        "initial_backoff_ns",
        "maximum_backoff_ns",
        "framing_work",
        "source_work",
        "maximum_steps",
        "timeout_ns",
        "report_bytes",
        "stop_after_frames_or_zero"
      ],
      "properties": {
        "http_header_bytes": {
          "const": 32768
        },
        "http_fragment_bytes": {
          "const": 16384
        },
        "http_chunk_bytes": {
          "const": 16777216
        },
        "http_chunks": {
          "const": 1000000
        },
        "wire_bytes_per_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "entity_bytes_per_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "multipart_header_bytes": {
          "const": 16384
        },
        "multipart_wrapper_bytes": {
          "const": 4096
        },
        "frame_bytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16777216
        },
        "read_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "frames_per_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "native_frames_with_lookahead": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4097
        },
        "source_runs": {
          "const": 65536
        },
        "io_calls_per_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "connect_timeout_ns": {
          "type": "integer",
          "minimum": 1000000,
          "maximum": 60000000000
        },
        "reads_per_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
