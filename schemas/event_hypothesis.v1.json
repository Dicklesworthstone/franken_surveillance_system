{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/event_hypothesis.v1.json",
  "title": "FSS Event Hypothesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eventId",
    "revision",
    "supersedes",
    "state",
    "kind",
    "timeInterval",
    "probability",
    "evidence",
    "decisionPath"
  ],
  "properties": {
    "schema": {
      "const": "fss.event_hypothesis.v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "hypothesized",
        "witnessed",
        "corroborated",
        "adjudicated",
        "alert_delivered",
        "resolved",
        "indeterminate",
        "rejected"
      ]
    },
    "kind": {
      "enum": [
        "perimeter_breach",
        "covert_approach",
        "sensor_tamper",
        "unknown_presence",
        "benign_routine",
        "unclassified"
      ]
    },
    "timeInterval": {
      "$ref": "sensor_capsule.v1.json#/$defs/timeInterval"
    },
    "uncertaintyReason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "zoneIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "trackIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "probability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "calibrationGeneration"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibrationGeneration": {
          "anyOf": [
            {
              "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest",
          "class",
          "failureDomain",
          "supports",
          "relation"
        ],
        "properties": {
          "digest": {
            "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
          },
          "class": {
            "enum": [
              "assertion",
              "derived",
              "observed",
              "corroborated",
              "verified"
            ]
          },
          "failureDomain": {
            "type": "string",
            "maxLength": 128
          },
          "supports": {
            "type": "boolean"
          },
          "relation": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "invalidates",
              "supersedes",
              "observed_after",
              "required_by",
              "explains"
            ]
          },
          "capsuleDigest": {
            "anyOf": [
              {
                "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
              },
              {
                "type": "null"
              }
            ]
          },
          "identityDigest": {
            "anyOf": [
              {
                "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "modelReceipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
      }
    },
    "decisionPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyGeneration",
        "fingerprint",
        "abstained"
      ],
      "properties": {
        "policyGeneration": {
          "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
        },
        "fingerprint": {
          "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
        },
        "abstained": {
          "type": "boolean"
        },
        "abstentionReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    }
  }
}
