{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/semantic_hydration_receipt.v1.json",
  "title": "Semantic Hydration Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receiptId",
    "receiptDigest",
    "requestDigest",
    "handleId",
    "descriptorDigest",
    "subjectDigest",
    "anchor",
    "requestedLevel",
    "availability",
    "cost",
    "completeness",
    "proofRoots",
    "invalidators",
    "issuedAtNs"
  ],
  "properties": {
    "schema": {"const": "fss.semantic_hydration_receipt.v1"},
    "receiptId": {"$ref": "#/$defs/stableId"},
    "receiptDigest": {"$ref": "#/$defs/digest"},
    "requestDigest": {"$ref": "#/$defs/digest"},
    "handleId": {"$ref": "#/$defs/stableId"},
    "descriptorDigest": {"$ref": "#/$defs/digest"},
    "subjectDigest": {"$ref": "#/$defs/digest"},
    "anchor": {"$ref": "evidence_anchor.v1.json"},
    "requestedLevel": {"enum": ["H0", "H1", "H2", "H3", "H4"]},
    "deliveredLevel": {
      "type": ["string", "null"],
      "enum": ["H0", "H1", "H2", "H3", "H4", null]
    },
    "availability": {
      "enum": [
        "available",
        "superseded",
        "deleted",
        "expired",
        "corrupt",
        "privacy_transformed",
        "not_observable"
      ]
    },
    "cost": {"$ref": "#/$defs/budget"},
    "completeness": {
      "enum": [
        "complete",
        "bounded",
        "partial",
        "unknown",
        "not_observable",
        "unauthorized",
        "stale"
      ]
    },
    "artifactDigest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "proofRoots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "continuation": {
      "oneOf": [
        {"$ref": "agent_continuation_cursor.v1.json"},
        {"type": "null"}
      ]
    },
    "invalidators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "issuedAtNs": {"type": "integer"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:+._/-]{1,511}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencyMs",
        "tokens",
        "bytes",
        "modelCalls",
        "cpuMillis",
        "acceleratorMillis",
        "energyMillijoules",
        "networkBytes",
        "storageOperations",
        "privacyExposure",
        "operatorAttentionSeconds"
      ],
      "properties": {
        "latencyMs": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "modelCalls": {"type": "integer", "minimum": 0},
        "cpuMillis": {"type": "integer", "minimum": 0},
        "acceleratorMillis": {"type": "integer", "minimum": 0},
        "energyMillijoules": {"type": "integer", "minimum": 0},
        "networkBytes": {"type": "integer", "minimum": 0},
        "storageOperations": {"type": "integer", "minimum": 0},
        "privacyExposure": {"type": "number", "minimum": 0},
        "operatorAttentionSeconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
