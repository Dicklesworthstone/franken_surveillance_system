{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/proof_check_receipt.v1.json",
  "title": "Formal proof check receipt v1",
  "$comment": "Mirrors the 'proof' claim-class check-receipt validation in scripts/claim_proof_bundle_checker.py: checker identity resolves in architecture/formal_toolchains.json, version is a concrete release (never a range/alias), status must be 'passed' to back a claim, and the artifact digest binds the exact formal artifact checked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim_id", "status", "checker", "checker_version", "model_id", "model_generation", "formal_artifact_digest", "theorem_statement"],
  "properties": {
    "schema": {"const": "fss.proof_check_receipt.v1"},
    "claim_id": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "checker": {"type": "string", "minLength": 1},
    "checker_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+(\\.[0-9]+)?(-[0-9A-Za-z.-]+)?)?$"},
    "model_id": {"type": "string", "minLength": 1},
    "model_generation": {"type": "string", "minLength": 1},
    "formal_artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "theorem_statement": {"type": "string", "minLength": 1}
  }
}
