{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/semantic_handle.v1.json",
  "title": "Semantic Handle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handleId",
    "descriptorDigest",
    "contractBasis",
    "anchor",
    "subjectId",
    "subjectDigest",
    "semanticType",
    "sourceId",
    "privacyClass",
    "availability",
    "retentionUntilNs",
    "levels",
    "requiredCapabilities",
    "estimatedCosts",
    "laboratoryAccess",
    "derivativeHandles",
    "publishedAtNs"
  ],
  "properties": {
    "schema": {"const": "fss.semantic_handle.v1"},
    "handleId": {"$ref": "#/$defs/stableId"},
    "descriptorDigest": {"$ref": "#/$defs/digest"},
    "contractBasis": {"$ref": "agent_contract_basis.v1.json"},
    "anchor": {"$ref": "evidence_anchor.v1.json"},
    "subjectId": {"$ref": "#/$defs/stableId"},
    "subjectDigest": {"$ref": "#/$defs/digest"},
    "semanticType": {"type": "string", "minLength": 1, "maxLength": 256},
    "sourceId": {"$ref": "#/$defs/stableId"},
    "captureInterval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["earliestNs", "latestNs"],
      "properties": {
        "earliestNs": {"type": "integer"},
        "latestNs": {"type": "integer"}
      }
    },
    "spatialScope": {"type": ["string", "null"], "maxLength": 4096},
    "privacyClass": {"type": "string", "minLength": 1, "maxLength": 256},
    "appliedTransform": {"type": ["string", "null"], "maxLength": 4096},
    "availability": {
      "enum": [
        "available",
        "superseded",
        "deleted",
        "expired",
        "corrupt",
        "privacy_transformed",
        "not_observable"
      ]
    },
    "retentionUntilNs": {"type": "integer"},
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/level"}
    },
    "requiredCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"enum": ["H0", "H1", "H2", "H3", "H4"]},
      "patternProperties": {
        "^H[0-4]$": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    "estimatedCosts": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"enum": ["H0", "H1", "H2", "H3", "H4"]},
      "patternProperties": {"^H[0-4]$": {"$ref": "#/$defs/budget"}}
    },
    "laboratoryAccess": {
      "enum": ["unavailable", "qualification_only", "qualification_or_debug_grant"]
    },
    "debugCapability": {"type": ["string", "null"], "maxLength": 256},
    "derivativeHandles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "publishedAtNs": {"type": "integer"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:+._-]{1,511}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "level": {"enum": ["H0", "H1", "H2", "H3", "H4"]},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencyMs",
        "tokens",
        "bytes",
        "modelCalls",
        "cpuMillis",
        "acceleratorMillis",
        "energyMillijoules",
        "networkBytes",
        "storageOperations",
        "privacyExposure",
        "operatorAttentionSeconds"
      ],
      "properties": {
        "latencyMs": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "modelCalls": {"type": "integer", "minimum": 0},
        "cpuMillis": {"type": "integer", "minimum": 0},
        "acceleratorMillis": {"type": "integer", "minimum": 0},
        "energyMillijoules": {"type": "integer", "minimum": 0},
        "networkBytes": {"type": "integer", "minimum": 0},
        "storageOperations": {"type": "integer", "minimum": 0},
        "privacyExposure": {"type": "number", "minimum": 0},
        "operatorAttentionSeconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
