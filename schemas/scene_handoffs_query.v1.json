{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/scene_handoffs_query.v1.json",
  "title": "Owner-declared anonymous tracklet handoff query",
  "description": "Bounded input assertions for one property/session/privacy/generation/clock scope. Handles do not authenticate custody. Cross-row consistency and robust transit admission are checked by the native planner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "time_unit", "cost_unit", "birth_cost", "end_cost", "k", "tracklets", "transitions"],
  "properties": {
    "schema": {"const": "fss.scene_handoffs_query.v1"},
    "scope": {"$ref": "#/$defs/scope"},
    "time_unit": {"$ref": "#/$defs/unit"},
    "cost_unit": {"$ref": "#/$defs/unit"},
    "birth_cost": {"$ref": "#/$defs/u64"},
    "end_cost": {"$ref": "#/$defs/u64"},
    "k": {"type": "integer", "minimum": 1, "maximum": 32},
    "tracklets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/tracklet"}},
    "transitions": {"type": "array", "maxItems": 992, "items": {"$ref": "#/$defs/transition"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9:_.-]+$"},
    "unit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9:_.-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "i64": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "clock_interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/i64"}},
    "transit_interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/u64"}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "session", "privacy_policy", "generation", "clock"],
      "properties": {
        "property": {"$ref": "#/$defs/id"},
        "session": {"$ref": "#/$defs/id"},
        "privacy_policy": {"$ref": "#/$defs/digest"},
        "generation": {"$ref": "#/$defs/digest"},
        "clock": {"$ref": "#/$defs/digest"}
      }
    },
    "tracklet": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "camera", "camera_generation", "calibration", "model", "evidence", "start", "end", "support"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "camera": {"$ref": "#/$defs/id"},
        "camera_generation": {"$ref": "#/$defs/digest"},
        "calibration": {"$ref": "#/$defs/digest"},
        "model": {"$ref": "#/$defs/digest"},
        "evidence": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "start": {"$ref": "#/$defs/clock_interval"},
        "end": {"$ref": "#/$defs/clock_interval"},
        "support": {"enum": ["declared", "missing", "invalidated", "redacted"]}
      },
      "allOf": [
        {"if": {"properties": {"support": {"const": "declared"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}
      ]
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "transit", "cost", "basis"],
      "properties": {
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "transit": {"$ref": "#/$defs/transit_interval"},
        "cost": {"$ref": "#/$defs/u64"},
        "basis": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
