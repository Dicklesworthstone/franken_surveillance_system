{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scene_feature_match_retained_query.v2.json",
  "title": "fss.scene_feature_match_retained_query.v2",
  "description": "Version 2 preserves the original retained source, clock, privacy and association contracts while replacing each view image_domain_digest with an explicit image declaration. Pinhole names its native domain; rectified declares source intrinsics, source domain, lens basis/family/coefficients, admitted normalized radius and decoded luma range. Target intrinsics come only from the exact selected rig camera, and the native plan derives the corrected output domain. Every plan must pass whole-domain lens admission before any source decode. Native source dimensions must match the source model; input and target are each bounded to 4096 per axis and 4194304 pixels. Every positive-weight interpolation tap must be source-allowed, and full descriptor support must be output-allowed. Mixed direct and corrected views are supported. No caller pixels, source timestamp, privacy mask, target override, fabricated output identity or calibration activation is accepted. sigma_pixels describes the actual output grid; interpolation correlation and lens-parameter error are outside conditional pixel-noise covariance. Native validation enforces exact numeric ranges and all existing selection/time bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "camera_rig_digest",
    "privacy_domain",
    "clock",
    "clock_evidence",
    "association_basis",
    "reference_time_ns",
    "max_capture_span_ns",
    "motion",
    "left",
    "right",
    "extraction",
    "matching"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_feature_match_retained_query.v2"
    },
    "camera_rig_digest": {
      "$ref": "#/$defs/digest"
    },
    "privacy_domain": {
      "$ref": "#/$defs/identity"
    },
    "clock": {
      "$ref": "#/$defs/identity"
    },
    "clock_evidence": {
      "$ref": "#/$defs/digest"
    },
    "association_basis": {
      "$ref": "#/$defs/digest"
    },
    "reference_time_ns": {
      "$ref": "#/$defs/u64"
    },
    "max_capture_span_ns": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})$"
        }
      ]
    },
    "motion": {
      "const": "static_during_capture_hull"
    },
    "left": {
      "$ref": "#/$defs/view"
    },
    "right": {
      "$ref": "#/$defs/view"
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "maximum_features",
        "separation"
      ],
      "properties": {
        "threshold": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 254
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}$"
            }
          ]
        },
        "maximum_features": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}$"
            }
          ]
        },
        "separation": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}$"
            }
          ]
        }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_hamming_distance",
        "ratio_percent",
        "maximum_epipolar_distance_pixels"
      ],
      "properties": {
        "maximum_hamming_distance": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,2})$"
            }
          ]
        },
        "ratio_percent": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,1}$"
            }
          ]
        },
        "maximum_epipolar_distance_pixels": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000
        }
      }
    },
    "triangulation": {
      "$ref": "#/$defs/triangulation"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "image",
        "mapping_basis",
        "sigma_pixels",
        "source",
        "alignment"
      ],
      "properties": {
        "camera": {
          "$ref": "#/$defs/identity"
        },
        "mapping_basis": {
          "$ref": "#/$defs/digest"
        },
        "sigma_pixels": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "alignment": {
          "$ref": "#/$defs/alignment"
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "min_views": {
          "enum": [
            2,
            "2"
          ]
        },
        "max_outliers": {
          "enum": [
            0,
            "0"
          ]
        },
        "max_reprojection_pixels": {
          "type": "number",
          "minimum": 0
        },
        "min_ray_angle_radians": {
          "type": "number",
          "minimum": 0
        },
        "max_distance": {
          "type": "number",
          "minimum": 0
        },
        "max_condition_number": {
          "type": "number",
          "minimum": 1
        },
        "max_iterations": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,1}$"
            }
          ]
        }
      }
    },
    "i64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]{0,18})$"
        }
      ],
      "description": "Canonical exact signed decimal literal; native validation enforces i64 bounds and refuses negative zero."
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "import_identity",
            "segment",
            "capsule_digest",
            "encoded_source_digest",
            "sensor_id",
            "component_interpretation"
          ],
          "properties": {
            "codec": {
              "const": "jpeg"
            },
            "import_identity": {
              "$ref": "#/$defs/digest"
            },
            "segment": {
              "$ref": "#/$defs/u64"
            },
            "capsule_digest": {
              "$ref": "#/$defs/digest"
            },
            "encoded_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "sensor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "component_interpretation": {
              "enum": [
                "grayscale",
                "ycbcr"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "import_identity",
            "segment",
            "capsule_digest",
            "encoded_source_digest",
            "sensor_id",
            "first_segment",
            "segment_count"
          ],
          "properties": {
            "codec": {
              "const": "h264"
            },
            "import_identity": {
              "$ref": "#/$defs/digest"
            },
            "segment": {
              "$ref": "#/$defs/u64"
            },
            "capsule_digest": {
              "$ref": "#/$defs/digest"
            },
            "encoded_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "sensor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "first_segment": {
              "$ref": "#/$defs/u64"
            },
            "segment_count": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                {
                  "type": "string",
                  "pattern": "^([1-9]|[1-5][0-9]|6[0-4])$"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "import_identity",
            "segment",
            "capsule_digest",
            "encoded_source_digest",
            "sensor_id",
            "first_segment",
            "segment_count"
          ],
          "properties": {
            "codec": {
              "const": "h265"
            },
            "import_identity": {
              "$ref": "#/$defs/digest"
            },
            "segment": {
              "$ref": "#/$defs/u64"
            },
            "capsule_digest": {
              "$ref": "#/$defs/digest"
            },
            "encoded_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "sensor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "first_segment": {
              "$ref": "#/$defs/u64"
            },
            "segment_count": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                {
                  "type": "string",
                  "pattern": "^([1-9]|[1-5][0-9]|6[0-4])$"
                }
              ]
            }
          }
        }
      ]
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_identity",
        "stream_id",
        "clock_basis",
        "offset_ns",
        "basis"
      ],
      "properties": {
        "import_identity": {
          "$ref": "#/$defs/digest"
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "clock_basis": {
          "enum": [
            "utc_disciplined",
            "device_monotonic",
            "host_monotonic",
            "estimated"
          ]
        },
        "offset_ns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/i64"
          }
        },
        "basis": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image_domain_digest"
          ],
          "properties": {
            "kind": {
              "const": "pinhole"
            },
            "image_domain_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source_domain_digest",
            "lens_basis",
            "source_intrinsics",
            "distortion",
            "maximum_radius",
            "luma_range"
          ],
          "properties": {
            "kind": {
              "const": "rectified"
            },
            "source_domain_digest": {
              "$ref": "#/$defs/digest"
            },
            "lens_basis": {
              "$ref": "#/$defs/digest"
            },
            "source_intrinsics": {
              "$ref": "#/$defs/raw_intrinsics"
            },
            "distortion": {
              "$ref": "#/$defs/distortion"
            },
            "maximum_radius": {
              "type": "number",
              "minimum": 1e-06,
              "maximum": 64
            },
            "luma_range": {
              "enum": [
                "full",
                "video"
              ]
            }
          }
        }
      ]
    },
    "raw_intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fx",
        "fy",
        "cx",
        "cy"
      ],
      "properties": {
        "width": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
            }
          ]
        },
        "height": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
            }
          ]
        },
        "fx": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000000.0
        },
        "fy": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000000.0
        },
        "cx": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "cy": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        }
      }
    },
    "distortion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "pinhole"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "radial",
            "tangential"
          ],
          "properties": {
            "kind": {
              "const": "brown_conrady"
            },
            "radial": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "minItems": 3,
              "maxItems": 3
            },
            "tangential": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients"
          ],
          "properties": {
            "kind": {
              "const": "fisheye"
            },
            "coefficients": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      ]
    }
  }
}
