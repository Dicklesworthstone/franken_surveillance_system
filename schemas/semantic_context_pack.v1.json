{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/semantic_context_pack.v1.json",
  "title": "Semantic Context Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractBasis",
    "packId",
    "missionId",
    "sessionId",
    "viewId",
    "anchor",
    "situationFingerprint",
    "items",
    "compressionReceiptId",
    "tokenCount",
    "packDigest",
    "createdAtNs"
  ],
  "properties": {
    "schema": {
      "const": "fss.semantic_context_pack.v1"
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "viewId": {
      "type": "string",
      "pattern": "^AVIEW-[0-9]{3}$"
    },
    "anchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "situationFingerprint": {
      "$ref": "sensor_capsule.v1.json#/$defs/digest"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "kind",
          "epistemicState",
          "content",
          "basis"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "alias": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 16384
          },
          "basis": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "scoreComponents": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "maxProperties": 64
          },
          "expansionHandles": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          }
        }
      }
    },
    "compressionReceiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0
    },
    "packDigest": {
      "$ref": "sensor_capsule.v1.json#/$defs/digest"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAtNs": {
      "type": "integer",
      "minimum": 0
    },
    "contractBasis": {
      "$ref": "agent_contract_basis.v1.json"
    }
  }
}
