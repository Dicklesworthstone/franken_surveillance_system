{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/investigation_state.v1.json",
  "title": "Investigation State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractBasis",
    "investigationId",
    "missionId",
    "revision",
    "state",
    "question",
    "decisionInformed",
    "basisAnchor",
    "hypotheses",
    "knowns",
    "unknowns",
    "discriminators",
    "probes",
    "decisionDeadlineNs",
    "stopRules"
  ],
  "properties": {
    "schema": {
      "const": "fss.investigation_state.v1"
    },
    "investigationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "draft",
        "active",
        "awaiting_evidence",
        "awaiting_approval",
        "blocked",
        "resolved",
        "refuted",
        "cancelled",
        "indeterminate",
        "closed"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "decisionInformed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "basisAnchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesisId",
          "description",
          "epistemicState",
          "predictions",
          "evidence",
          "contradictions"
        ],
        "properties": {
          "hypothesisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "predictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "contradictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "openSet": {
            "type": "boolean"
          }
        }
      }
    },
    "knowns": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statementId",
          "text",
          "epistemicState",
          "basis"
        ],
        "properties": {
          "statementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "basis": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "contradictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "validUntilNs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statementId",
          "text",
          "epistemicState",
          "basis"
        ],
        "properties": {
          "statementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "basis": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "contradictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "validUntilNs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statementId",
          "text",
          "epistemicState",
          "basis"
        ],
        "properties": {
          "statementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "basis": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "contradictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "validUntilNs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "discriminators": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discriminatorId",
          "description",
          "separates",
          "expectedOutcomes"
        ],
        "properties": {
          "discriminatorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "separates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "expectedOutcomes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "selectedProbeIds": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "decisionDeadlineNs": {
      "type": "integer",
      "minimum": 0
    },
    "stopRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "acceptableResidualUncertainty": {
      "type": "number",
      "minimum": 0
    },
    "blockedBy": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "conclusion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8192
    },
    "resolutionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contractBasis": {
      "$ref": "agent_contract_basis.v1.json"
    }
  }
}
