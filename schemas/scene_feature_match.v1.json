{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/scene_feature_match.v1.json",
  "title": "Complete native local-image feature matching and 3D hypotheses",
  "description": "Maximum8MiB including newline. SHA256 report_digest hashes the exact UTF8 report member. Native owners additionally enforce exact source hashes, complete Cartesian rows and per-feature outcomes, symmetric descriptor uniqueness, camera/time/privacy/image-domain agreement, no omitted selected hypothesis, finite native geometry and full byte/work/cancellation bounds. Refusals are retained, empty support is not success, and conditional geometry never establishes physical identity or calibrated accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_digest",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_feature_match.v1"
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "physical_identity_established",
        "outcome",
        "query_digest",
        "association_evidence",
        "reference_time_ns",
        "capture_hull_ns",
        "clock",
        "clock_evidence",
        "privacy_domain",
        "basis",
        "declarations",
        "assumptions",
        "views",
        "pairs",
        "feature_outcomes",
        "hypotheses",
        "counts",
        "work"
      ],
      "properties": {
        "schema": {
          "const": "fss.scene_feature_match_report.v1"
        },
        "authority": {
          "const": "derived_cognition_no_effect_authority"
        },
        "physical_identity_established": {
          "const": false
        },
        "outcome": {
          "enum": [
            "no_reconstruction",
            "reconstructed",
            "reconstructed_with_refusals"
          ]
        },
        "query_digest": {
          "$ref": "#/$defs/digest"
        },
        "association_evidence": {
          "$ref": "#/$defs/digest"
        },
        "reference_time_ns": {
          "$ref": "#/$defs/u64"
        },
        "capture_hull_ns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u64"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "clock": {
          "$ref": "#/$defs/identity"
        },
        "clock_evidence": {
          "$ref": "#/$defs/digest"
        },
        "privacy_domain": {
          "$ref": "#/$defs/identity"
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "twin_digest",
            "source_scene_digest",
            "camera_rig_digest",
            "camera_rig_semantic_digest",
            "geometry_basis",
            "coordinate_frame",
            "evaluation_scope",
            "observation_epoch",
            "scale",
            "map_error"
          ],
          "properties": {
            "twin_digest": {
              "$ref": "#/$defs/digest"
            },
            "source_scene_digest": {
              "$ref": "#/$defs/digest"
            },
            "camera_rig_digest": {
              "$ref": "#/$defs/digest"
            },
            "camera_rig_semantic_digest": {
              "$ref": "#/$defs/digest"
            },
            "geometry_basis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "revision"
              ],
              "properties": {
                "property": {
                  "$ref": "#/$defs/identity"
                },
                "revision": {
                  "$ref": "#/$defs/identity"
                }
              }
            },
            "coordinate_frame": {
              "const": "RH_Z_UP"
            },
            "evaluation_scope": {
              "type": "string",
              "maxLength": 2048
            },
            "observation_epoch": {
              "type": "string",
              "maxLength": 256
            },
            "scale": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "metres_per_unit",
                "error",
                "coordinates"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "relative",
                    "estimated",
                    "measured_anchor"
                  ]
                },
                "metres_per_unit": {
                  "$ref": "#/$defs/metric"
                },
                "error": {
                  "$ref": "#/$defs/metric"
                },
                "coordinates": {
                  "const": "source_world_units_unchanged"
                }
              }
            },
            "map_error": {
              "$ref": "#/$defs/metric"
            }
          }
        },
        "declarations": {
          "$ref": "scene_feature_match_query.v1.json"
        },
        "assumptions": {
          "const": {
            "source_custody": "exact_local_jpeg_bytes_not_retained_deployment_custody",
            "image_domain": "caller_declared_undistorted_pixels_orientation_and_rig_mapping",
            "calibration": "authored_nominal_rig_not_activated_or_physically_validated",
            "time": "caller_declared_common_capture_clock_not_packet_arrival",
            "motion": "common_features_stationary_over_full_capture_hull",
            "correspondence": "conditional_appearance_and_epipolar_hypotheses_not_physical_identity",
            "privacy": "explicit_input_mask_policy_not_an_access_grant",
            "covariance_scope": "conditional_independent_isotropic_pixel_noise_only",
            "covariance_excludes": [
              "camera_pose",
              "intrinsics",
              "clock",
              "correspondence",
              "motion",
              "rolling_shutter",
              "shared_failure_modes",
              "map_error"
            ],
            "scene_claim": "derived_static_feature_points_no_world_publication"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "camera",
              "source_object_id",
              "calibration",
              "image_domain",
              "clock",
              "privacy_domain",
              "validity_ns",
              "capture_ns",
              "sigma_pixels",
              "status",
              "calibration_error",
              "world_to_camera",
              "intrinsics",
              "source_digest",
              "pixel_digest",
              "image_domain_digest",
              "mapping_basis",
              "allowed_mask_digest",
              "descriptor_domain",
              "decoder",
              "selection",
              "features"
            ],
            "properties": {
              "camera": {
                "$ref": "#/$defs/identity"
              },
              "source_object_id": {
                "type": "string",
                "maxLength": 256
              },
              "calibration": {
                "$ref": "#/$defs/identity"
              },
              "image_domain": {
                "$ref": "#/$defs/identity"
              },
              "clock": {
                "$ref": "#/$defs/identity"
              },
              "privacy_domain": {
                "$ref": "#/$defs/identity"
              },
              "validity_ns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/u64"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "capture_ns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/u64"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "sigma_pixels": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 1000
              },
              "status": {
                "const": "authored_nominal"
              },
              "calibration_error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "unknown"
                  }
                }
              },
              "world_to_camera": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rotation",
                  "translation"
                ],
                "properties": {
                  "rotation": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "translation": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              },
              "intrinsics": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "width",
                  "height",
                  "fx",
                  "fy",
                  "cx",
                  "cy",
                  "image_model"
                ],
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "fx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "fy": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cx": {
                    "type": "number"
                  },
                  "cy": {
                    "type": "number"
                  },
                  "image_model": {
                    "const": "undistorted_pinhole"
                  }
                }
              },
              "source_digest": {
                "$ref": "#/$defs/digest"
              },
              "pixel_digest": {
                "$ref": "#/$defs/digest"
              },
              "image_domain_digest": {
                "$ref": "#/$defs/digest"
              },
              "mapping_basis": {
                "$ref": "#/$defs/digest"
              },
              "allowed_mask_digest": {
                "$ref": "#/$defs/digest"
              },
              "descriptor_domain": {
                "$ref": "#/$defs/digest"
              },
              "decoder": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "component_interpretation",
                  "mcus",
                  "entropy_blocks",
                  "restarts",
                  "metadata_segments",
                  "metadata_bytes"
                ],
                "properties": {
                  "identity": {
                    "$ref": "#/$defs/digest"
                  },
                  "component_interpretation": {
                    "enum": [
                      "grayscale",
                      "ycbcr"
                    ]
                  },
                  "mcus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "entropy_blocks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "restarts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "metadata_segments": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "metadata_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  }
                }
              },
              "selection": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "maximum_features",
                  "separation",
                  "tested_centers",
                  "local_maxima",
                  "selected",
                  "omitted"
                ],
                "properties": {
                  "threshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "maximum_features": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "separation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "tested_centers": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "local_maxima": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "selected": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "omitted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  }
                }
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "feature",
                    "pixel",
                    "descriptor_digest"
                  ],
                  "properties": {
                    "feature": {
                      "$ref": "#/$defs/identity"
                    },
                    "pixel": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "descriptor_digest": {
                      "$ref": "#/$defs/digest"
                    }
                  }
                },
                "minItems": 0,
                "maxItems": 128
              }
            }
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "features",
              "hamming_distance",
              "descriptor",
              "epipolar",
              "epipolar_distance_pixels",
              "hypothesis"
            ],
            "properties": {
              "features": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identity"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "hamming_distance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "descriptor": {
                "enum": [
                  "too_distant",
                  "ambiguous",
                  "non_mutual",
                  "candidate"
                ]
              },
              "epipolar": {
                "enum": [
                  "passed",
                  "outside_gate",
                  "unobservable"
                ]
              },
              "epipolar_distance_pixels": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state",
                      "values"
                    ],
                    "properties": {
                      "state": {
                        "const": "available"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state"
                    ],
                    "properties": {
                      "state": {
                        "const": "unobservable"
                      }
                    }
                  }
                ]
              },
              "hypothesis": {
                "$ref": "#/$defs/hypothesis"
              }
            }
          },
          "minItems": 0,
          "maxItems": 16384
        },
        "feature_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "camera",
              "feature",
              "nearest_features",
              "best_hamming_distance",
              "runner_up_hamming_distance",
              "disposition",
              "hypothesis"
            ],
            "properties": {
              "camera": {
                "$ref": "#/$defs/identity"
              },
              "feature": {
                "$ref": "#/$defs/identity"
              },
              "nearest_features": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identity"
                },
                "minItems": 0,
                "maxItems": 128
              },
              "best_hamming_distance": {
                "$ref": "#/$defs/metric"
              },
              "runner_up_hamming_distance": {
                "$ref": "#/$defs/metric"
              },
              "disposition": {
                "enum": [
                  "no_counterpart",
                  "too_distant",
                  "ambiguous",
                  "non_mutual",
                  "epipolar_rejected",
                  "epipolar_unobservable",
                  "selected"
                ]
              },
              "hypothesis": {
                "$ref": "#/$defs/hypothesis"
              }
            }
          },
          "minItems": 0,
          "maxItems": 256
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "features",
              "evidence_digest",
              "estimate"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "features": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identity"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "evidence_digest": {
                "$ref": "#/$defs/digest"
              },
              "estimate": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state",
                      "reason"
                    ],
                    "properties": {
                      "state": {
                        "const": "refused"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state",
                      "position",
                      "reference_time_ns",
                      "pixel_noise_covariance",
                      "covariance_coordinates",
                      "condition_number",
                      "rms_reprojection_pixels",
                      "max_ray_angle_radians",
                      "capture_hull_ns",
                      "nominal_occlusion_conflict",
                      "views"
                    ],
                    "properties": {
                      "state": {
                        "const": "estimated"
                      },
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "reference_time_ns": {
                        "$ref": "#/$defs/u64"
                      },
                      "pixel_noise_covariance": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "covariance_coordinates": {
                        "const": "x_y_z_in_source_world_units"
                      },
                      "condition_number": {
                        "type": "number",
                        "minimum": 0
                      },
                      "rms_reprojection_pixels": {
                        "type": "number",
                        "minimum": 0
                      },
                      "max_ray_angle_radians": {
                        "type": "number",
                        "minimum": 0
                      },
                      "capture_hull_ns": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/u64"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "nominal_occlusion_conflict": {
                        "type": "boolean"
                      },
                      "views": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "camera",
                            "evidence_digest",
                            "capture_ns",
                            "pixel_min",
                            "pixel_max",
                            "inlier",
                            "residual_pixels",
                            "visibility"
                          ],
                          "properties": {
                            "camera": {
                              "$ref": "#/$defs/identity"
                            },
                            "evidence_digest": {
                              "$ref": "#/$defs/digest"
                            },
                            "capture_ns": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/u64"
                              },
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "pixel_min": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "pixel_max": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "inlier": {
                              "type": "boolean"
                            },
                            "residual_pixels": {
                              "$ref": "#/$defs/metric"
                            },
                            "visibility": {
                              "enum": [
                                "nominally_occluded",
                                "nominal_segment_clear",
                                "projection_unavailable"
                              ]
                            }
                          }
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 128
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "features",
            "pairs",
            "selected",
            "solved",
            "refused"
          ],
          "properties": {
            "features": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "pairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "selected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "solved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "refused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowance",
            "used"
          ],
          "properties": {
            "allowance": {
              "$ref": "#/$defs/u64"
            },
            "used": {
              "$ref": "#/$defs/u64"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "hypothesis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "index"
          ],
          "properties": {
            "state": {
              "const": "attempted"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "not_selected"
            }
          }
        }
      ]
    }
  }
}
