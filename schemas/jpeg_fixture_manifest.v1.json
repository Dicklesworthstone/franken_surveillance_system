{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/jpeg_fixture_manifest.v1.json",
  "title": "JPEG Fixture Manifest v1",
  "description": "Test suite manifest for deterministic baseline JPEG fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixtures"
  ],
  "properties": {
    "schema": {
      "const": "fss.jpeg_fixture_manifest.v1"
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height",
          "channels",
          "pixel_format",
          "subsampling",
          "quality",
          "restart_interval",
          "file_sha256",
          "source_pixel_sha256",
          "file_size"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "pixel_format": {
            "type": "string"
          },
          "subsampling": {
            "type": "string"
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "restart_interval": {
            "type": "integer",
            "minimum": 0
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_pixel_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "file_size": {
            "type": "integer",
            "minimum": 0
          },
          "encoder_psnr": {
            "type": "number"
          },
          "psnr": {
            "type": "number"
          },
          "encoder_max_error": {
            "type": "integer",
            "minimum": 0
          },
          "max_error": {
            "type": "integer",
            "minimum": 0
          },
          "psnr_threshold": {
            "type": "number"
          }
        }
      }
    }
  }
}
