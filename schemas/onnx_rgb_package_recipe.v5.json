{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/onnx_rgb_package_recipe.v5.json",
  "title": "fss.onnx_rgb_package_recipe.v5",
  "description": "Explicit local detector recipe v5: all v2 image preprocessing choices plus ordered, named static F32 batch-one DFL feature levels. Each level declares its output, unique stride and NCHW or NHWC layout; all levels have 4*bins plus the complete score-tail fields. Native Transpose, Reshape and Concat pack the levels in caller order before the existing DFL expected-bin decoder. Source output declaration order never determines scale order. Every original output and parameter remains intact; only the distinct rows/pixel-corners decoded output is added publicly. Native validation additionally enforces unique level names and strides, exact target/stride spatial shapes, cumulative import and decode quotas, cancellation, pins, licensing and head semantics. The source and final package formats remain unchanged. No model family, objectness, score activation, calibration or quality is inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "model_id",
    "model_generation",
    "tensor_generation",
    "preprocess",
    "head",
    "labels",
    "source",
    "license",
    "head_decode"
  ],
  "properties": {
    "format": {
      "const": "fss.onnx_rgb_package_recipe.v5"
    },
    "model_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^MOD-[A-Z0-9-]+$"
    },
    "model_generation": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^(?!.*latest)[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "tensor_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_input",
        "height",
        "width",
        "resize",
        "letterbox_pad",
        "masked_rgb",
        "scale_to_unit",
        "channel_order",
        "mean",
        "standard_deviation"
      ],
      "properties": {
        "image_input": {
          "$ref": "#/$defs/text512"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "resize": {
          "enum": [
            "nearest",
            "bilinear"
          ]
        },
        "letterbox_pad": {
          "$ref": "#/$defs/byte"
        },
        "masked_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "scale_to_unit": {
          "type": "boolean"
        },
        "channel_order": {
          "enum": [
            "rgb",
            "bgr"
          ],
          "description": "Explicit model-input channel order after native RGB scaling; never inferred."
        },
        "mean": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38
          },
          "description": "Finite F32 subtraction values in model-input channel order, using the units selected by scale_to_unit."
        },
        "standard_deviation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3.4028234663852886e+38
          },
          "description": "Strictly positive finite F32 divisors. Native validation rejects values rounding to zero and normalization overflow."
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_port",
        "layout",
        "boxes",
        "class_score",
        "objectness",
        "classes",
        "minimum_score_ppm",
        "nms_iou_ppm",
        "maximum_rows",
        "maximum_candidates",
        "maximum_detections"
      ],
      "properties": {
        "output_port": {
          "$ref": "#/$defs/text128"
        },
        "layout": {
          "const": "rows"
        },
        "boxes": {
          "const": "pixel-corners"
        },
        "class_score": {
          "enum": [
            "probability",
            "logit"
          ]
        },
        "objectness": {
          "enum": [
            "none",
            "probability",
            "logit"
          ]
        },
        "classes": {
          "enum": [
            "best",
            "multi-label"
          ]
        },
        "minimum_score_ppm": {
          "$ref": "#/$defs/ppm"
        },
        "nms_iou_ppm": {
          "$ref": "#/$defs/ppm"
        },
        "maximum_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maximum_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximum_detections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text128"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "revision",
        "producer"
      ],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/text256"
        },
        "revision": {
          "$ref": "#/$defs/text128"
        },
        "producer": {
          "$ref": "#/$defs/text512"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "use_approved",
        "restrictions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text128"
        },
        "use_approved": {
          "type": "boolean",
          "description": "Explicit operator decision; the existing surveillance-monitoring license policy still decides whether packaging is admitted."
        },
        "restrictions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text256"
          }
        }
      }
    },
    "head_decode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bins",
        "levels"
      ],
      "properties": {
        "kind": {
          "const": "anchor-free-dfl-pyramid"
        },
        "bins": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Exact caller order is preserved. Output names and strides must each be unique; every stride must divide both target dimensions. Native validation enforces these cross-field rules and the aggregate 32768-row ceiling.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "output",
              "stride",
              "layout"
            ],
            "properties": {
              "output": {
                "$ref": "#/$defs/text512"
              },
              "stride": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "layout": {
                "enum": [
                  "nchw",
                  "nhwc"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "text128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "text256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "text512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  }
}
