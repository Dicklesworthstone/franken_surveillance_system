{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/reconstruction_atlas_adopted_provenance.v2.json",
  "title": "fss.reconstruction_atlas_adopted_provenance.v2",
  "description": "Complete static reconstruction-to-atlas provenance under explicit current adopted-radial image preparation. The unchanged FSATLAS1 archive pins SHA-256 of these exact UTF-8 bytes, without a circular archive package hash. Retains exact current calibration/adoption lineage and conditional covariance, refined two-term radial model and original source grid, full direct or corrected source image records, every actual model/map/mask/coverage receipt, complete rig/query/selection declarations and all selected/unselected native geometry diagnostics. Corrected target K/grid are the refined original camera; zero-radial cameras may remain direct. Source and current authority are revalidated under the deployment lock before publication. No measured physical calibration accuracy, enduring-static truth, identity or future source access is inferred. Absolute landmark error remains unknown; covariance excludes lens-parameter error and interpolation correlation. Manifest/report are bounded to 32 MiB; FSATLAS1 remains unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "twin_digest",
    "source_scene_digest",
    "geometry_basis",
    "coordinate_frame",
    "scale",
    "camera_rig_digest",
    "camera_rig_semantic_digest",
    "query_digest",
    "query_declarations",
    "selection_digest",
    "selection",
    "entry_anchor_digest",
    "entry_anchor",
    "anchor_digest",
    "anchor",
    "source_records",
    "geometry",
    "atlas_build",
    "assumptions",
    "evaluation_scope",
    "observation_epoch",
    "map_error",
    "rig_declarations",
    "calibration"
  ],
  "properties": {
    "schema": {
      "const": "fss.reconstruction_atlas_adopted_provenance.v2"
    },
    "authority": {
      "const": "derived_cognition_no_effect_authority"
    },
    "twin_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "source_scene_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "geometry_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "revision"
      ],
      "properties": {
        "property": {
          "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/identity"
        },
        "revision": {
          "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/identity"
        }
      }
    },
    "coordinate_frame": {
      "const": "RH_Z_UP"
    },
    "scale": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/scale"
    },
    "camera_rig_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "camera_rig_semantic_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "query_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "query_declarations": {
      "allOf": [
        {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/declarations"
        },
        {
          "properties": {
            "schema": {
              "enum": [
                "fss.scene_feature_match_retained_query.v1",
                "fss.scene_feature_match_retained_query.v2",
                "fss.scene_feature_multimatch_retained_query.v1",
                "fss.scene_feature_multimatch_retained_query.v2"
              ]
            }
          }
        }
      ],
      "description": "Existing exact static pair/multiview query semantics plus the v2 adopted image profile: direct original-domain pinhole only for zero-radial cameras, or exact native two-term Brown preparation from the selected calibration. Moving reconstructions cannot supply this static atlas."
    },
    "selection_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "selection": {
      "$ref": "reconstruction_atlas_selection.v1.json"
    },
    "entry_anchor_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "entry_anchor": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/anchor"
    },
    "anchor_digest": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
    },
    "anchor": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/anchor"
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera",
          "record_digest",
          "record"
        ],
        "properties": {
          "camera": {
            "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/identity"
          },
          "record_digest": {
            "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/digest"
          },
          "record": {
            "$ref": "scene_feature_match_adopted.v2.json#/$defs/source_view"
          }
        }
      },
      "minItems": 2,
      "maxItems": 8,
      "description": "Complete native canonical camera inventory, including any source whose features were not selected into the atlas. record_digest is SHA-256 of the exact serialized record bytes and equals the corresponding native receipt/source-record pin; this equality and source/camera binding are checked by the producer/command, not inferred by JSON Schema."
    },
    "geometry": {
      "allOf": [
        {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/geometry"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "static_pair",
                "static_multiview"
              ]
            }
          }
        }
      ],
      "description": "Unchanged strict adopted reconstruction envelope. It retains every native pair/feature/component alternative, including unselected refusals and nominal occlusion conflicts. Export can admit eligible explicitly selected points even when other components remain unresolved."
    },
    "atlas_build": {
      "$ref": "reconstruction_atlas_provenance.v1.json#/$defs/receipt"
    },
    "assumptions": {
      "const": [
        "atlas_is_a_derived_candidate_and_does_not_activate_calibration_or_change_the_twin",
        "current_adoption_is_owner_authority_not_an_independent_physical_calibration_measurement",
        "source_camera_poses_and_intrinsics_come_only_from_the_exact_current_adopted_candidate",
        "source_domain_refined_intrinsics_and_two_term_radial_model_come_only_from_the_exact_current_calibration",
        "native_rectification_target_is_the_exact_refined_original_camera_grid_without_crop_zoom_or_rotation_override",
        "nonzero_radial_sources_require_native_rectification_and_zero_radial_direct_sources_preserve_the_original_domain",
        "rectified_views_use_declared_radius_and_luma_transfer_not_calibration_measurements",
        "every_requested_lens_plan_is_admitted_before_source_decode_and_full_model_map_mask_and_image_receipts_are_preserved",
        "native_rectification_preserves_original_exposure_and_requires_all_positive_weight_privacy_taps_and_descriptor_support",
        "current_adoption_and_withdrawal_are_revalidated_at_the_report_anchor_before_publication",
        "all_original_source_ranges_and_current_privacy_are_revalidated_before_publication",
        "enduring_static_eligibility_and_twin_feature_assignments_are_explicit_owner_declarations",
        "physical_groups_are_declared_alias_groups_not_authenticated_object_identity",
        "all_selected_landmark_member_views_and_actual_native_descriptors_are_preserved",
        "all_unselected_candidates_and_geometric_refusals_remain_in_the_manifest",
        "capture_window_stationarity_does_not_establish_enduring_landmark_stability",
        "absolute_landmark_error_remains_unknown_and_is_not_derived_from_pixel_covariance",
        "reconstruction_pixel_covariance_excludes_interpolation_correlations_and_lens_parameter_error",
        "reconstruction_pixel_covariance_excludes_shared_camera_map_clock_and_correspondence_error",
        "local_calibration_covariance_is_conditional_and_has_no_cross_camera_covariance_blocks",
        "archive_checksums_do_not_grant_source_access_or_establish_future_source_privacy",
        "reference_exposures_are_not_independent_localization_validation_observations",
        "coordinates_remain_in_the_exact_twin_source_units_and_scale_basis"
      ]
    },
    "evaluation_scope": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/evaluation_scope"
    },
    "observation_epoch": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/observation_epoch"
    },
    "map_error": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/map_error"
    },
    "rig_declarations": {
      "$ref": "scene_camera_rig_adopted.v2.json"
    },
    "calibration": {
      "$ref": "scene_feature_match_adopted.v2.json#/$defs/calibration"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "atlas_build": {
            "properties": {
              "kind": {
                "const": "pair"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "atlas_build"
        ]
      },
      "then": {
        "properties": {
          "geometry": {
            "properties": {
              "kind": {
                "const": "static_pair"
              }
            }
          },
          "query_declarations": {
            "properties": {
              "schema": {
                "enum": [
                  "fss.scene_feature_match_retained_query.v1",
                  "fss.scene_feature_match_retained_query.v2"
                ]
              }
            }
          },
          "source_records": {
            "minItems": 2,
            "maxItems": 2
          },
          "calibration": {
            "properties": {
              "selected_cameras": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "rig_declarations": {
            "properties": {
              "cameras": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "atlas_build": {
            "properties": {
              "kind": {
                "const": "multiview"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "atlas_build"
        ]
      },
      "then": {
        "properties": {
          "geometry": {
            "properties": {
              "kind": {
                "const": "static_multiview"
              }
            }
          },
          "query_declarations": {
            "properties": {
              "schema": {
                "enum": [
                  "fss.scene_feature_multimatch_retained_query.v1",
                  "fss.scene_feature_multimatch_retained_query.v2"
                ]
              }
            }
          },
          "source_records": {
            "minItems": 3,
            "maxItems": 8
          },
          "calibration": {
            "properties": {
              "selected_cameras": {
                "minItems": 3,
                "maxItems": 8
              }
            }
          },
          "rig_declarations": {
            "properties": {
              "cameras": {
                "minItems": 3,
                "maxItems": 8
              }
            }
          }
        }
      }
    }
  ]
}
