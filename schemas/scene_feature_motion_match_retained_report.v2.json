        },
        "original_query_json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "contentMediaType": "application/json",
          "contentSchema": {
            "$ref": "clock_validation_query.v1.json"
          },
          "description": "Exact independently pinned original UTF-8 query text, not a successful-report replacement. Native replay checks its byte digest; contentSchema is descriptive and does not replace native admission."
        },
        "native_replay": {
          "$ref": "clock_validation_replay_response.v1.json"
        },
        "mapped_exposures": {
          "type": "array",
          "minItems": 4,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
