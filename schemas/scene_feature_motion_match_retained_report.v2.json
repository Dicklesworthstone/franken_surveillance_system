        },
        "original_capture_ns": {
          "$ref": "#/$defs/original_capture"
        },
        "common_capture_ns": {
          "$ref": "#/$defs/capture"
        },
        "projection_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identity"
            }
          ]
        },
        "mapping": {
          "enum": [
            "reference_clock_identity",
            "complete_native_hypothesis_hull"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "projection_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "mapping": {
                "const": "reference_clock_identity"
              }
            }
          },
          "else": {
            "properties": {
              "mapping": {
                "const": "complete_native_hypothesis_hull"
              }
            }
          }
        }
      ]
    },
    "clock_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "query_digest",
        "original_query_json",
        "native_replay",
        "mapped_exposures",
        "clock_synchronization_established",
        "clock_query_source_custody_verified",
        "source_clock_basis_upgraded"
      ],
      "properties": {
        "authority": {
          "const": "replayed_declared_clock_hypotheses_no_activation"
        },
        "query_digest": {
