{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/formal_model.v1.json",
  "title": "Formal model manifest v1",
  "$comment": "Mirrors the 'proof' claim-class model-manifest validation in scripts/claim_proof_bundle_checker.py (pinned by tests/test_claim_proof_bundle_checker.py proof fixtures): a digest-bound manifest naming the exact formal model source backing a theorem claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "generation", "claim_ids", "source"],
  "properties": {
    "schema": {"const": "fss.formal_model.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "generation": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
