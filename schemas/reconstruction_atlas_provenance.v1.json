{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/reconstruction_atlas_provenance.v1.json",
  "title": "fss.reconstruction_atlas_provenance.v1",
  "description": "Complete source/rig/query/selection/native-geometry/atlas-admission manifest. The exact UTF-8 bytes are retained as provenance_manifest_utf8 in the export report; SHA256 of those bytes is the FSATLAS1 provenance pin. The manifest contains the semantic atlas digest but excludes the final package hash to avoid a circular identity. All original sources, current masks, lens transforms and candidate alternatives remain present. Archive/source hashes confer no calibration, future privacy or physical identity authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "twin_digest",
    "source_scene_digest",
    "geometry_basis",
    "coordinate_frame",
    "scale",
    "camera_rig_digest",
    "camera_rig_semantic_digest",
    "query_digest",
    "query_declarations",
    "selection_digest",
    "selection",
    "entry_anchor_digest",
    "entry_anchor",
    "anchor_digest",
    "anchor",
    "source_records",
    "geometry",
    "atlas_build",
    "assumptions",
    "evaluation_scope",
    "observation_epoch",
    "map_error"
  ],
  "properties": {
    "schema": {
      "const": "fss.reconstruction_atlas_provenance.v1"
    },
    "authority": {
      "const": "derived_cognition_no_effect_authority"
    },
    "twin_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_scene_digest": {
      "$ref": "#/$defs/digest"
    },
    "geometry_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "revision"
      ],
      "properties": {
        "property": {
          "$ref": "#/$defs/identity"
        },
        "revision": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "coordinate_frame": {
      "const": "RH_Z_UP"
    },
    "scale": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/scale"
    },
    "camera_rig_digest": {
      "$ref": "#/$defs/digest"
    },
    "camera_rig_semantic_digest": {
      "$ref": "#/$defs/digest"
    },
    "query_digest": {
      "$ref": "#/$defs/digest"
    },
    "query_declarations": {
      "oneOf": [
        {
          "$ref": "scene_feature_match_retained_query.v1.json"
        },
        {
          "$ref": "scene_feature_match_retained_query.v2.json"
        },
        {
          "$ref": "scene_feature_multimatch_retained_query.v1.json"
        },
        {
          "$ref": "scene_feature_multimatch_retained_query.v2.json"
        }
      ]
    },
    "selection_digest": {
      "$ref": "#/$defs/digest"
    },
    "selection": {
      "$ref": "reconstruction_atlas_selection.v1.json"
    },
    "entry_anchor_digest": {
      "$ref": "#/$defs/digest"
    },
    "entry_anchor": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/anchor"
    },
    "anchor_digest": {
      "$ref": "#/$defs/digest"
    },
    "anchor": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/anchor"
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera",
          "record_digest",
          "record"
        ],
        "properties": {
          "camera": {
            "$ref": "#/$defs/identity"
          },
          "record_digest": {
            "$ref": "#/$defs/digest"
          },
          "record": {
            "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/views/items"
          }
        }
      },
      "minItems": 2,
      "maxItems": 8
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/pair_geometry"
        },
        {
          "$ref": "scene_feature_multimatch_retained.v2.json#/$defs/geometry"
        }
      ]
    },
    "atlas_build": {
      "$ref": "#/$defs/receipt"
    },
    "assumptions": {
      "const": [
        "atlas_is_a_derived_candidate_and_does_not_activate_calibration",
        "enduring_static_eligibility_and_twin_feature_assignments_are_explicit_owner_declarations",
        "physical_groups_are_declared_alias_groups_not_authenticated_object_identity",
        "all_selected_landmark_member_views_and_actual_native_descriptors_are_preserved",
        "capture_window_stationarity_does_not_establish_enduring_landmark_stability",
        "source_camera_poses_and_image_models_remain_the_original_rig_declarations",
        "absolute_landmark_error_remains_unknown_and_is_not_derived_from_pixel_covariance",
        "reconstruction_pixel_covariance_excludes_shared_camera_map_lens_clock_and_correspondence_error",
        "archive_checksums_do_not_grant_source_access_or_establish_future_source_privacy",
        "reference_exposures_are_not_independent_localization_validation_observations",
        "coordinates_remain_in_the_exact_twin_source_units_and_scale_basis"
      ]
    },
    "evaluation_scope": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/evaluation_scope"
    },
    "observation_epoch": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/observation_epoch"
    },
    "map_error": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/basis/properties/map_error"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "atlas_build": {
            "properties": {
              "kind": {
                "const": "pair"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "geometry": {
            "$ref": "#/$defs/pair_geometry"
          }
        }
      },
      "else": {
        "properties": {
          "geometry": {
            "$ref": "scene_feature_multimatch_retained.v2.json#/$defs/geometry"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "identity": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "covariance3": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "interval": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/u64"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "image": {
      "$ref": "scene_feature_match_retained.v2.json#/$defs/output_image"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera",
          "feature"
        ],
        "properties": {
          "camera": {
            "$ref": "#/$defs/identity"
          },
          "feature": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "selection_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "landmark",
        "physical_group",
        "feature",
        "enduring_static_basis"
      ],
      "properties": {
        "hypothesis": {
          "$ref": "#/$defs/digest"
        },
        "landmark": {
          "$ref": "#/$defs/identity"
        },
        "physical_group": {
          "$ref": "#/$defs/identity"
        },
        "feature": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "enduring_static_basis": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_digest",
        "kind",
        "twin_digest",
        "association_evidence",
        "requested_scene_time_ns",
        "capture_hull_ns",
        "sources",
        "candidates",
        "landmarks",
        "atlas_digest"
      ],
      "properties": {
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": [
            "pair",
            "multiview"
          ]
        },
        "twin_digest": {
          "$ref": "#/$defs/digest"
        },
        "association_evidence": {
          "$ref": "#/$defs/digest"
        },
        "requested_scene_time_ns": {
          "$ref": "#/$defs/u64"
        },
        "capture_hull_ns": {
          "$ref": "#/$defs/interval"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "camera",
              "source_record_digest",
              "encoded_source_digest",
              "frame",
              "descriptor_domain_digest",
              "allowed_mask_digest",
              "feature_count",
              "included_in_archive"
            ],
            "properties": {
              "camera": {
                "$ref": "#/$defs/identity"
              },
              "source_record_digest": {
                "$ref": "#/$defs/digest"
              },
              "encoded_source_digest": {
                "$ref": "#/$defs/digest"
              },
              "frame": {
                "$ref": "#/$defs/image"
              },
              "descriptor_domain_digest": {
                "$ref": "#/$defs/digest"
              },
              "allowed_mask_digest": {
                "$ref": "#/$defs/digest"
              },
              "feature_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "included_in_archive": {
                "type": "boolean"
              }
            }
          },
          "minItems": 2,
          "maxItems": 8
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis",
              "members",
              "capture_hull_ns",
              "solve_time_ns",
              "disposition",
              "selection"
            ],
            "properties": {
              "hypothesis": {
                "$ref": "#/$defs/digest"
              },
              "members": {
                "$ref": "#/$defs/members"
              },
              "capture_hull_ns": {
                "$ref": "#/$defs/interval"
              },
              "solve_time_ns": {
                "$ref": "#/$defs/u64"
              },
              "disposition": {
                "enum": [
                  "eligible",
                  "refused",
                  "unmatched",
                  "camera_conflict",
                  "incomplete_cycle_support",
                  "nominal_occlusion_conflict"
                ]
              },
              "selection": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state",
                      "landmark"
                    ],
                    "properties": {
                      "state": {
                        "const": "selected"
                      },
                      "landmark": {
                        "$ref": "#/$defs/identity"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state"
                    ],
                    "properties": {
                      "state": {
                        "const": "not_selected"
                      }
                    }
                  }
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 256
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selection",
              "landmark_evidence",
              "members",
              "position",
              "absolute_error",
              "pixel_noise_covariance",
              "condition_number",
              "rms_reprojection_pixels",
              "max_ray_angle_radians",
              "residuals",
              "capture_hull_ns",
              "solve_time_ns"
            ],
            "properties": {
              "selection": {
                "$ref": "#/$defs/selection_row"
              },
              "landmark_evidence": {
                "$ref": "#/$defs/digest"
              },
              "members": {
                "$ref": "#/$defs/members"
              },
              "position": {
                "$ref": "#/$defs/vector3"
              },
              "absolute_error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "unknown"
                  }
                }
              },
              "pixel_noise_covariance": {
                "$ref": "#/$defs/covariance3"
              },
              "condition_number": {
                "type": "number",
                "minimum": 0
              },
              "rms_reprojection_pixels": {
                "type": "number",
                "minimum": 0
              },
              "max_ray_angle_radians": {
                "type": "number",
                "minimum": 0,
                "maximum": 3.141592653589793
              },
              "residuals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "camera",
                    "inlier",
                    "pixels"
                  ],
                  "properties": {
                    "camera": {
                      "$ref": "#/$defs/identity"
                    },
                    "inlier": {
                      "const": true
                    },
                    "pixels": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "state",
                            "value"
                          ],
                          "properties": {
                            "state": {
                              "const": "available"
                            },
                            "value": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "state"
                          ],
                          "properties": {
                            "state": {
                              "const": "unavailable"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "minItems": 2,
                "maxItems": 8
              },
              "capture_hull_ns": {
                "$ref": "#/$defs/interval"
              },
              "solve_time_ns": {
                "$ref": "#/$defs/u64"
              }
            }
          },
          "minItems": 1,
          "maxItems": 128
        },
        "atlas_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "pair_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_evidence",
        "requested_scene_time_ns",
        "capture_hull_ns",
        "pairs",
        "feature_outcomes",
        "hypotheses",
        "counts"
      ],
      "properties": {
        "scene_evidence": {
          "$ref": "#/$defs/digest"
        },
        "requested_scene_time_ns": {
          "$ref": "#/$defs/u64"
        },
        "capture_hull_ns": {
          "$ref": "#/$defs/interval"
        },
        "pairs": {
          "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/pairs"
        },
        "feature_outcomes": {
          "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/feature_outcomes"
        },
        "hypotheses": {
          "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/hypotheses"
        },
        "counts": {
          "$ref": "scene_feature_match_retained.v2.json#/$defs/analysis/properties/counts"
        }
      }
    }
  }
}
