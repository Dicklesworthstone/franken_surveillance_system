{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/onnx_rgb_package_recipe.v3.json",
  "title": "fss.onnx_rgb_package_recipe.v3",
  "description": "Explicit local detector recipe v3: all v2 image preprocessing choices plus one declared static anchor-free DFL distance-head decoder. The original source output is retained; a distinct new rows/pixel-corners output is frozen into the same native graph using existing operators. Raw rows follow the ordered feature strides then row-major y,x cells. Each image dimension must be divisible by every stride and the raw row count must equal the sum of those grids. Four consecutive groups of bins hold left, top, right, bottom logits; the score tail is preserved unchanged. Softmax-bin expectation is multiplied by stride before adding/subtracting the exact pixel grid center (x+0.5,y+0.5)*stride. Native validation additionally enforces exact shapes, graph/parameter/name bounds, finite arithmetic, cumulative quotas, pins, licensing and cancellation. No head convention or identity is inferred; this profile is not generic raw YOLO/anchor decoding or model-quality qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "model_id",
    "model_generation",
    "tensor_generation",
    "preprocess",
    "head",
    "labels",
    "source",
    "license",
    "head_decode"
  ],
  "properties": {
    "format": {
      "const": "fss.onnx_rgb_package_recipe.v3"
    },
    "model_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^MOD-[A-Z0-9-]+$"
    },
    "model_generation": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^(?!.*latest)[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "tensor_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_input",
        "height",
        "width",
        "resize",
        "letterbox_pad",
        "masked_rgb",
        "scale_to_unit",
        "channel_order",
        "mean",
        "standard_deviation"
      ],
      "properties": {
        "image_input": {
          "$ref": "#/$defs/text512"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "resize": {
          "enum": [
            "nearest",
            "bilinear"
          ]
        },
        "letterbox_pad": {
          "$ref": "#/$defs/byte"
        },
        "masked_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "scale_to_unit": {
          "type": "boolean"
        },
        "channel_order": {
          "enum": [
            "rgb",
            "bgr"
          ],
          "description": "Explicit model-input channel order after native RGB scaling; never inferred."
        },
        "mean": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38
          },
          "description": "Finite F32 subtraction values in model-input channel order, using the units selected by scale_to_unit."
        },
        "standard_deviation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3.4028234663852886e+38
          },
          "description": "Strictly positive finite F32 divisors. Native validation rejects values rounding to zero and normalization overflow."
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_port",
        "layout",
        "boxes",
        "class_score",
        "objectness",
        "classes",
        "minimum_score_ppm",
        "nms_iou_ppm",
        "maximum_rows",
        "maximum_candidates",
        "maximum_detections"
      ],
      "properties": {
        "output_port": {
          "$ref": "#/$defs/text128"
        },
        "layout": {
          "const": "rows"
        },
        "boxes": {
          "const": "pixel-corners"
        },
        "class_score": {
          "enum": [
            "probability",
            "logit"
          ]
        },
        "objectness": {
          "enum": [
            "none",
            "probability",
            "logit"
          ]
        },
        "classes": {
          "enum": [
            "best",
            "multi-label"
          ]
        },
        "minimum_score_ppm": {
          "$ref": "#/$defs/ppm"
        },
        "nms_iou_ppm": {
          "$ref": "#/$defs/ppm"
        },
        "maximum_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maximum_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximum_detections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text128"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "revision",
        "producer"
      ],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/text256"
        },
        "revision": {
          "$ref": "#/$defs/text128"
        },
        "producer": {
          "$ref": "#/$defs/text512"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "use_approved",
        "restrictions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text128"
        },
        "use_approved": {
          "type": "boolean",
          "description": "Explicit operator decision; the existing surveillance-monitoring license policy still decides whether packaging is admitted."
        },
        "restrictions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text256"
          }
        }
      }
    },
    "head_decode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "raw_output",
        "raw_layout",
        "bins",
        "strides"
      ],
      "properties": {
        "kind": {
          "const": "anchor-free-dfl"
        },
        "raw_output": {
          "$ref": "#/$defs/text512"
        },
        "raw_layout": {
          "enum": [
            "rows",
            "channels"
          ]
        },
        "bins": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "strides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      }
    }
  },
  "$defs": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "text128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "text256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "text512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  }
}
