{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/agent_knowledge_cell.v1.json",
  "title": "Agent Knowledge Cell v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cellId",
    "subject",
    "predicate",
    "knowledgeState",
    "provenanceClass",
    "basisAnchor",
    "validity",
    "supportingEvidence",
    "contradictingEvidence",
    "uncertainty",
    "completeness",
    "decisionRelevance"
  ],
  "properties": {
    "schema": {
      "const": "fss.agent_knowledge_cell.v1"
    },
    "cellId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "predicate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "value": {},
    "knowledgeState": {
      "enum": [
        "known",
        "estimated",
        "unknown",
        "conflicted",
        "stale",
        "not_observable",
        "redacted",
        "indeterminate",
        "not_applicable"
      ]
    },
    "provenanceClass": {
      "enum": [
        "observed",
        "derived",
        "predicted",
        "remembered",
        "operator_asserted",
        "vendor_claimed",
        "policy"
      ]
    },
    "basisAnchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "sourceGeneration": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal",
        "spatial",
        "policy",
        "model",
        "privacy"
      ],
      "properties": {
        "temporal": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "spatial": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "policy": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "model": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "privacy": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "invalidators": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "supportingEvidence": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
      }
    },
    "contradictingEvidence": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
      }
    },
    "sharedFailureDomains": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "interval",
            "distribution",
            "set",
            "qualitative",
            "unknown"
          ]
        },
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "calibrationId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "completeness": {
      "enum": [
        "complete_for_domain",
        "bounded_partial",
        "uncertified",
        "not_applicable"
      ]
    },
    "decisionRelevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missions",
        "canChangeAction",
        "priorityClass"
      ],
      "properties": {
        "missions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "canChangeAction": {
          "type": "boolean"
        },
        "priorityClass": {
          "enum": [
            "constitutional",
            "critical",
            "high",
            "normal",
            "low"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "explanationHandle": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "expiresAtNs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "hypothesisDisposition": {
      "description": "Hypothesis disposition, when applicable (KnowledgeCell.hypothesis).",
      "enum": [
        "live",
        "supported",
        "disfavored",
        "refuted",
        "resolved",
        "superseded"
      ]
    },
    "stateBasis": {
      "description": "Typed basis required by `redacted` (redaction marker), `stale` (older anchor or generation), and `indeterminate` (reconciliation basis and branches); optional typed reason on `unknown`; refused on every other knowledge state (KnowledgeCell.state_basis).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basisKind"
      ],
      "properties": {
        "basisKind": {
          "enum": [
            "redaction",
            "stale",
            "reconciliation",
            "unknown"
          ]
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "privacyGeneration"
          ],
          "properties": {
            "reason": {
              "description": "Projection that withholds the proposition or its evidence (KSTATE-007).",
              "enum": [
                "privacy_projection",
                "capability_projection"
              ]
            },
            "privacyGeneration": {
              "description": "Exact privacy projection generation that applied the redaction.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
            }
          }
        },
        "stale": {
          "description": "Older anchor or generation the proposition was last valid at; must be strictly older than the current side (KSTATE-005).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "staleKind"
          ],
          "properties": {
            "staleKind": {
              "enum": [
                "older_anchor",
                "older_generation"
              ]
            },
            "validAt": {
              "description": "Anchor or generation at which the proposition was last valid.",
              "type": [
                "object",
                "integer"
              ],
              "minimum": 0
            },
            "current": {
              "description": "Current anchor or generation the proposition has not been revalidated against.",
              "type": [
                "object",
                "integer"
              ],
              "minimum": 0
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unresolvedOutcomeRoot",
            "branches"
          ],
          "properties": {
            "unresolvedOutcomeRoot": {
              "description": "Root of the attempt receipt or event revision whose outcome is unresolved.",
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "branches": {
              "description": "Branches kept open until the outcome is proved or safely negated; must include both occurred and not_occurred.",
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "occurred",
                  "not_occurred",
                  "partially_occurred"
                ]
              }
            }
          }
        },
        "unknown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "description": "Typed reason the authorized evidence so far does not establish the proposition (KSTATE-003).",
              "enum": [
                "continuity_gap_before_capsule",
                "stale_without_observed_basis",
                "redaction_context_not_supplied"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "knowledgeState": {
            "const": "redacted"
          }
        },
        "required": [
          "knowledgeState"
        ]
      },
      "then": {
        "required": [
          "stateBasis"
        ],
        "properties": {
          "stateBasis": {
            "properties": {
              "basisKind": {
                "const": "redaction"
              }
            },
            "required": [
              "basisKind",
              "redaction"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "knowledgeState": {
            "const": "stale"
          }
        },
        "required": [
          "knowledgeState"
        ]
      },
      "then": {
        "required": [
          "stateBasis"
        ],
        "properties": {
          "stateBasis": {
            "properties": {
              "basisKind": {
                "const": "stale"
              }
            },
            "required": [
              "basisKind",
              "stale"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "knowledgeState": {
            "const": "indeterminate"
          }
        },
        "required": [
          "knowledgeState"
        ]
      },
      "then": {
        "required": [
          "stateBasis"
        ],
        "properties": {
          "stateBasis": {
            "properties": {
              "basisKind": {
                "const": "reconciliation"
              }
            },
            "required": [
              "basisKind",
              "reconciliation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "knowledgeState": {
            "enum": [
              "known",
              "estimated",
              "conflicted",
              "not_observable",
              "not_applicable"
            ]
          }
        },
        "required": [
          "knowledgeState"
        ]
      },
      "then": {
        "not": {
          "required": [
            "stateBasis"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "knowledgeState": {
            "const": "unknown"
          }
        },
        "required": [
          "knowledgeState"
        ]
      },
      "then": {
        "properties": {
          "stateBasis": {
            "properties": {
              "basisKind": {
                "const": "unknown"
              }
            }
          }
        }
      }
    }
  ]
}
