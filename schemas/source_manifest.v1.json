{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/source_manifest.v1.json",
  "title": "Frozen release source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "sourceCommit",
    "sourceDateEpoch",
    "fileCount",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "fss.source_manifest.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "fileCount": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "executable"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "executable": {
            "type": "boolean"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
