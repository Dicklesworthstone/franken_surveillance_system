{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scene_feature_motion_match_retained_query.v1.json",
  "title": "fss.scene_feature_motion_match_retained_query.v1",
  "description": "Exact repeated retained exposure selection for automatic native descriptor correspondence and conditional constant-velocity reconstruction. Four to sixteen distinct capsules/exposures, two to eight fixed logical cameras, one-to-one sensor/camera mapping, fixed stream/image/mapping/alignment per camera. Image uses existing v2 pinhole/rectified source syntax. Source time, pixels, masks and geometry cannot be overridden. At most 256 actual selected features; the entire capture hull and every interval must fit explicit bounds. No static epipolar gate or source/identity/effect authority is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "camera_rig_digest",
    "privacy_domain",
    "clock",
    "clock_evidence",
    "association_basis",
    "reference_time_ns",
    "extraction",
    "max_capture_span_ns",
    "max_capture_uncertainty_ns",
    "motion",
    "views",
    "matching"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_feature_motion_match_retained_query.v1"
    },
    "camera_rig_digest": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/camera_rig_digest"
    },
    "privacy_domain": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/privacy_domain"
    },
    "clock": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/clock"
    },
    "clock_evidence": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/clock_evidence"
    },
    "association_basis": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/association_basis"
    },
    "reference_time_ns": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/reference_time_ns"
    },
    "extraction": {
      "$ref": "scene_feature_match_retained_query.v2.json#/properties/extraction"
    },
    "max_capture_span_ns": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000000000
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,9}|[1-5][0-9]{10}|60000000000)$"
        }
      ]
    },
    "max_capture_uncertainty_ns": {
      "description": "Must also be <= max_capture_span_ns; zero requires exact capture times.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000000000
        },
        {
          "type": "string",
          "pattern": "^(?:0|(?:[1-9][0-9]{0,9}|[1-5][0-9]{10}|60000000000))$"
        }
      ]
    },
    "motion": {
      "const": "constant_velocity_during_capture_hull"
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "scene_feature_match_retained_query.v2.json#/$defs/view"
      },
      "minItems": 4,
      "maxItems": 16
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_hamming_distance",
        "ratio_percent"
      ],
      "properties": {
        "maximum_hamming_distance": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-6])$"
            }
          ]
        },
        "ratio_percent": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]?$"
            }
          ]
        }
      }
    },
    "triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "max_reprojection_pixels": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000.0
        },
        "max_distance": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000000000.0
        },
        "max_speed": {
          "type": "number",
          "minimum": 1e-09,
          "maximum": 1000000000000.0
        },
        "max_condition_number": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000000000000.0
        },
        "max_iterations": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            {
              "type": "string",
              "pattern": "^(?:[1-9]|[12][0-9]|3[0-2])$"
            }
          ]
        }
      }
    }
  }
}
