{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/reconstruction_atlas_retained.v1.json",
  "title": "fss.reconstruction_atlas_retained.v1",
  "description": "Complete private owner-local FSATLAS1 export receipt, after final original custody/current-privacy revalidation. The exact compact UTF-8 report body determines report_digest. Whole output including newline is bounded to32MiB; the native archive is bounded to8MiB. Failed analysis emits no successful report and creates no atlas; publication I/O failures can leave new files requiring inspection. Existing files are never overwritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_digest",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "fss.reconstruction_atlas_retained.v1"
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "archive",
        "provenance_manifest_utf8",
        "cost"
      ],
      "properties": {
        "schema": {
          "const": "fss.reconstruction_atlas_retained_report.v1"
        },
        "outcome": {
          "const": "candidate_export"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "package_digest",
            "provenance_digest",
            "atlas_digest",
            "descriptor_digest",
            "bytes",
            "landmarks",
            "references",
            "bindings"
          ],
          "properties": {
            "format": {
              "const": "FSATLAS1"
            },
            "package_digest": {
              "$ref": "#/$defs/digest"
            },
            "provenance_digest": {
              "$ref": "#/$defs/digest"
            },
            "atlas_digest": {
              "$ref": "#/$defs/digest"
            },
            "descriptor_digest": {
              "$ref": "#/$defs/digest"
            },
            "bytes": {
              "type": "integer",
              "minimum": 188,
              "maximum": 8388608
            },
            "landmarks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "references": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "bindings": {
              "type": "integer",
              "minimum": 2,
              "maximum": 256
            }
          }
        },
        "provenance_manifest_utf8": {
          "type": "string",
          "maxLength": 33554432,
          "contentMediaType": "application/json",
          "contentSchema": {
            "$ref": "reconstruction_atlas_provenance.v1.json"
          },
          "description": "Exact original UTF-8 JSON manifest string. Validate its decoded contents against the provenance schema and hash its UTF-8 bytes, without recanonicalization; contentSchema may be annotation-only in some validators."
        },
        "cost": {
          "$ref": "scene_feature_multimatch_retained.v2.json#/$defs/cost"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    }
  }
}
