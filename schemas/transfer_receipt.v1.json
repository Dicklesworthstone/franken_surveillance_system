{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/transfer_receipt.v1.json",
  "title": "FSS ATP Transfer Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transferId",
    "rootDigest",
    "state",
    "source",
    "destination",
    "bytes",
    "objects",
    "verification",
    "timestamps"
  ],
  "properties": {
    "schema": {
      "const": "fss.transfer_receipt.v1"
    },
    "transferId": {
      "type": "string",
      "maxLength": 128
    },
    "rootDigest": {
      "$ref": "sensor_capsule.v1.json#/$defs/digest"
    },
    "state": {
      "enum": [
        "planned",
        "reserved",
        "manifest_verified",
        "fetching",
        "staged",
        "object_verified",
        "graph_closed",
        "exposure_ready",
        "root_published",
        "replica_qualified",
        "retrievability_verified",
        "complete",
        "scrubbed",
        "retired",
        "quarantined",
        "cancelled",
        "failed",
        "indeterminate"
      ]
    },
    "semanticState": {
      "enum": [
        "atp.semantic.proposed",
        "atp.semantic.reserved",
        "atp.semantic.offered",
        "atp.semantic.receiving",
        "atp.semantic.children_verified",
        "atp.semantic.graph_closed",
        "atp.semantic.durability_satisfied",
        "atp.semantic.root_committed",
        "atp.semantic.receipt_sealed",
        "atp.semantic.rejected",
        "atp.semantic.aborted",
        "atp.semantic.quarantined",
        "atp.semantic.indeterminate",
        "atp.semantic.superseded"
      ]
    },
    "archiveState": {
      "enum": [
        "atp.archive.planned",
        "atp.archive.reserved",
        "atp.archive.manifest_verified",
        "atp.archive.fetching",
        "atp.archive.staged",
        "atp.archive.object_verified",
        "atp.archive.graph_closed",
        "atp.archive.exposure_ready",
        "atp.archive.root_published",
        "atp.archive.replica_qualified",
        "atp.archive.retrievability_verified",
        "atp.archive.complete",
        "atp.archive.scrubbed",
        "atp.archive.retired",
        "atp.archive.quarantined",
        "atp.archive.cancelled",
        "atp.archive.failed",
        "atp.archive.indeterminate"
      ]
    },
    "pathStates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pathId",
          "state",
          "liveWork"
        ],
        "properties": {
          "pathId": {
            "type": "string",
            "maxLength": 128
          },
          "state": {
            "enum": [
              "atp.path.discover",
              "atp.path.candidate",
              "atp.path.probing",
              "atp.path.active",
              "atp.path.suspect",
              "atp.path.draining",
              "atp.path.closed"
            ]
          },
          "liveWork": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "publicationFence": {
      "type": "integer",
      "minimum": 0
    },
    "contractBasisDigest": {
      "anyOf": [
        {
          "$ref": "sensor_capsule.v1.json#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offeredBytes",
        "receivedBytes",
        "verifiedBytes",
        "committedBytes",
        "reusedBytes",
        "offeredObjects",
        "verifiedObjects",
        "committedObjects"
      ],
      "properties": {
        "offeredBytes": {
          "type": "integer",
          "minimum": 0
        },
        "receivedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "committedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "reusedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "offeredObjects": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedObjects": {
          "type": "integer",
          "minimum": 0
        },
        "committedObjects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "providerTuple": {
      "type": "string",
      "maxLength": 256
    },
    "proofOfRetrievability": {
      "anyOf": [
        {
          "$ref": "sensor_capsule.v1.json#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "reconciliationObligation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "obligationId",
            "fence",
            "reason"
          ],
          "properties": {
            "obligationId": {
              "type": "string",
              "maxLength": 128
            },
            "fence": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 256
    },
    "destination": {
      "type": "string",
      "maxLength": 256
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "objects": {
      "type": "integer",
      "minimum": 0
    },
    "paths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbolsUsed": {
          "type": "integer",
          "minimum": 0
        },
        "postRepairDigest": {
          "anyOf": [
            {
              "$ref": "sensor_capsule.v1.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "objects",
        "closure",
        "root"
      ],
      "properties": {
        "manifest": {
          "type": "boolean"
        },
        "objects": {
          "type": "boolean"
        },
        "closure": {
          "type": "boolean"
        },
        "root": {
          "type": "boolean"
        },
        "retrievability": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "journalDigest": {
      "anyOf": [
        {
          "$ref": "sensor_capsule.v1.json#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}
