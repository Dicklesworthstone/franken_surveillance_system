{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/site_camera_manifest.v1.json",
  "title": "FSS site camera manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "site_id",
    "generation",
    "network_route",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "fss.site_camera_manifest.v1"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "network_route": {
      "enum": [
        "lan",
        "vpn"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "generation",
          "kind",
          "peer",
          "authority",
          "stream_role",
          "retention_class",
          "rights_verdict_ref",
          "zones",
          "payment_masks",
          "max_connections",
          "owner_authorized",
          "plaintext",
          "retain_originals"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "kind": {
            "enum": [
              "rtsp",
              "onvif",
              "unifi_protect",
              "nvr_channel"
            ]
          },
          "peer": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^(?:[0-9]{1,3}(?:\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]+\\]):[1-9][0-9]{0,4}$",
            "description": "Canonical literal SocketAddr, nonzero port and non-unspecified/non-multicast/non-broadcast address. No DNS or scoped IPv6."
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Credential-free exact host[:port] or [IPv6][:port] label. Explicit port and literal IP must match peer. Host labels are never resolved."
          },
          "presentation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^/[^\\s]*$",
                "description": "Exact credential-free RTSP path plus optional query. Existing native URI rules reject controls, userinfo, fragments, escaped separators, traversal and double decoding. Query credential keys are refused. Complete rtsp://authority/path URI is at most 2048 bytes."
              },
              {
                "type": "null"
              }
            ]
          },
          "control_root": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^/[A-Za-z0-9/._~-]*$",
                "description": "No duplicate separators or dot components. Must contain presentation in its path subtree."
              },
              {
                "type": "null"
              }
            ]
          },
          "onvif_service_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^/[A-Za-z0-9/._~-]*$",
                "description": "No duplicate separators or dot components. Must contain presentation in its path subtree."
              },
              {
                "type": "null"
              }
            ]
          },
          "unifi_camera_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stream_role": {
            "enum": [
              "main",
              "sub"
            ]
          },
          "authentication": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "credential_file",
                  "realm",
                  "legacy_md5",
                  "legacy_no_qop"
                ],
                "properties": {
                  "credential_file": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 4096,
                    "pattern": "^/",
                    "description": "Absolute UTF-8 file reference only; no trailing slash, repeated slash, controls or dot components. Never opened by the parser/compiler."
                  },
                  "realm": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "legacy_md5": {
                    "type": "boolean"
                  },
                  "legacy_no_qop": {
                    "type": "boolean"
                  }
                },
                "description": "No inline credentials. Legacy no-qop requires explicit legacy MD5 opt-in."
              },
              {
                "type": "null"
              }
            ]
          },
          "retention_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "rights_verdict_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "zones": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zone_id",
                "kind",
                "vertices"
              ],
              "properties": {
                "zone_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "kind": {
                  "enum": [
                    "queue",
                    "register",
                    "door",
                    "lane_order",
                    "lane_pay",
                    "lane_present",
                    "payment",
                    "payment_terminal",
                    "other"
                  ]
                },
                "vertices": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    }
                  },
                  "description": "Simple non-degenerate polygon, normalized millionths; no repeated closing point. Self-intersections and overlapping edges refused."
                }
              }
            }
          },
          "payment_masks": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999999
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999999
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "description": "Normalized millionths. x+width and y+height must be <=1000000. This declaration is not proof that masking has been applied."
            }
          },
          "max_connections": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "All sources sharing a canonical literal IP must declare the same ceiling. This is a declared device budget, not a running concurrency scheduler or proof of physical device identity."
          },
          "owner_authorized": {
            "type": "boolean"
          },
          "plaintext": {
            "type": "boolean"
          },
          "retain_originals": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "rtsp",
                    "nvr_channel"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "presentation",
                "control_root"
              ],
              "properties": {
                "presentation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^/[^\\s]*$",
                  "description": "Exact credential-free RTSP path plus optional query. Existing native URI rules reject controls, userinfo, fragments, escaped separators, traversal and double decoding. Query credential keys are refused. Complete rtsp://authority/path URI is at most 2048 bytes."
                },
                "control_root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^/[A-Za-z0-9/._~-]*$",
                  "description": "No duplicate separators or dot components. Must contain presentation in its path subtree."
                },
                "onvif_service_path": {
                  "type": "null"
                },
                "unifi_camera_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "onvif"
                }
              }
            },
            "then": {
              "required": [
                "onvif_service_path"
              ],
              "properties": {
                "onvif_service_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^/[A-Za-z0-9/._~-]*$",
                  "description": "No duplicate separators or dot components. Must contain presentation in its path subtree."
                },
                "presentation": {
                  "type": "null"
                },
                "control_root": {
                  "type": "null"
                },
                "unifi_camera_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unifi_protect"
                }
              }
            },
            "then": {
              "required": [
                "unifi_camera_id"
              ],
              "properties": {
                "unifi_camera_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "presentation": {
                  "type": "null"
                },
                "control_root": {
                  "type": "null"
                },
                "onvif_service_path": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "description": "Requested immutable source scope. Owner/plaintext/retention booleans are explicit attestations, not authenticated rights or capture authority. Unsupported source kinds remain typed inputs and must be refused by an unqualified compiler."
      },
      "description": "Ordered source inventory. The native validator rejects duplicate RTSP/NVR routes using canonical peer IP, port, normalized authority host and validated presentation. Distinct paths and virtual hosts remain legal. Shared literal IPs use one conservative connection declaration, including across ports and IPv4-mapped IPv6 spellings."
    }
  },
  "description": "VIT-001 pure input; <=1 MiB, unique source IDs, <=8192 total polygon vertices plus strict shared JSON depth/node/string bounds. No filesystem/network/secret reads, rights verification, masking or recording. Canonical typed field encoding, not JSON spelling, defines the manifest digest."
}
