{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_scene_digest",
    "twin_digest",
    "geometry_basis",
    "coordinate_frame",
    "evaluation_scope",
    "calibration",
    "cameras"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_camera_rig_adopted.v1"
    },
    "source_scene_digest": {
      "$ref": "#/$defs/digest"
    },
    "twin_digest": {
      "$ref": "#/$defs/digest"
    },
    "geometry_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "revision"
      ],
      "properties": {
        "property": {
          "$ref": "#/$defs/identity"
        },
        "revision": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "coordinate_frame": {
      "const": "RH_Z_UP"
    },
    "evaluation_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "not": {
        "pattern": "^\\s*$"
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "file_digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "file_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scene_camera_rig_adopted.v1.json",
  "title": "fss.scene_camera_rig_adopted.v1",
  "description": "Strict retained-adoption selection, never caller-authored camera geometry. Calibration digest is the FSSCAL01/02 domain-separated identity; file_digest hashes all file bytes. Each original_input names the exact correspondence file or JPEG metadata already pinned by the calibration. Native admission additionally requires unique camera/sensor/source-object bindings, ordered inclusive validity, the exact imported twin/scope, current unwithdrawn adoption and fixed physical sensor, and calibrated original pinhole image domain/dimensions. The selected query camera set must equal this complete rig set. Paths and labels have separate UTF-8 byte bounds. Clock, privacy namespace, source-object binding and use validity remain owner declarations. No pose, intrinsics, status or error override is permitted.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "u64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        }
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "not": {
        "pattern": "^\\s*$"
      },
      "description": "Resolved relative to the rig file when not absolute. The native parser separately enforces this limit in UTF-8 bytes; paths are not opened by schema validation."
    },
    "pinned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "sensor_id",
        "adoption_digest",
        "original_input",
        "source_object_id",
        "image_domain",
        "clock",
        "privacy_domain",
        "validity_ns"
      ],
      "properties": {
        "camera": {
          "$ref": "#/$defs/identity"
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "adoption_digest": {
          "$ref": "#/$defs/digest"
        },
        "original_input": {
          "$ref": "#/$defs/pinned_file"
        },
        "source_object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "not": {
            "pattern": "^\\s*$"
          }
        },
        "image_domain": {
          "$ref": "#/$defs/identity"
        },
        "clock": {
          "$ref": "#/$defs/identity"
        },
        "privacy_domain": {
          "$ref": "#/$defs/identity"
        },
        "validity_ns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u64"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
