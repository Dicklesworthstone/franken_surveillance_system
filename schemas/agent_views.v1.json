{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/agent_views.v1.json",
  "title": "Agent Views v1",
  "description": "Machine registry of the registered fss/1 agent views (AVIEW-001..AVIEW-008). Mirrored by registries/AGENT_VIEWS.md and enforced against the typed Rust table in crates/fss-core/src/agent_view.rs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asOf",
    "views"
  ],
  "properties": {
    "schema": {
      "const": "fss.agent_views.v1"
    },
    "asOf": {
      "type": "string",
      "minLength": 1
    },
    "views": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "purpose",
          "requiredSections",
          "targetTokens",
          "maximumTokens",
          "gate",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AVIEW-00[1-8]$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "owner": {
            "type": "string",
            "pattern": "^fss-[a-z0-9-]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "requiredSections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
            }
          },
          "targetTokens": {
            "type": "integer",
            "minimum": 1
          },
          "maximumTokens": {
            "type": "integer",
            "minimum": 1
          },
          "gate": {
            "const": "QL-AGENT-001"
          },
          "status": {
            "const": "specified"
          }
        }
      }
    }
  }
}
