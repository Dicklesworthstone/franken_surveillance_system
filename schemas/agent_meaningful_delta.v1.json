{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/agent_meaningful_delta.v1.json",
  "title": "Agent Meaningful Delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractBasis",
    "deltaId",
    "sessionId",
    "basisFrameId",
    "resultFrameId",
    "basisAnchor",
    "resultAnchor",
    "classes",
    "changedCells",
    "invalidatedAssumptions",
    "coverageChanges",
    "obligationChanges",
    "effectUncertaintyChanges",
    "priority",
    "continuation",
    "selectionWitness"
  ],
  "properties": {
    "schema": {
      "const": "fss.agent_meaningful_delta.v1"
    },
    "deltaId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "basisFrameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "resultFrameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "basisAnchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "resultAnchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "material_state",
          "hypothesis",
          "contradiction",
          "coverage_loss",
          "coverage_recovery",
          "sensor_health",
          "plan_invalidation",
          "obligation",
          "effect_uncertainty",
          "policy_or_authority",
          "budget_pressure",
          "terminal_transition",
          "no_meaningful_change"
        ]
      }
    },
    "changedCells": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "agent_knowledge_cell.v1.json"
      }
    },
    "invalidatedAssumptions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "coverageChanges": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "obligationChanges": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "effectUncertaintyChanges": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "coalescedCount": {
      "type": "integer",
      "minimum": 0
    },
    "omittedCount": {
      "type": "integer",
      "minimum": 0
    },
    "omissionReasons": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "priority": {
      "enum": [
        "constitutional",
        "critical",
        "high",
        "normal",
        "low"
      ]
    },
    "continuation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "silenceCertificate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "selectionWitness": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "contractBasis": {
      "$ref": "agent_contract_basis.v1.json"
    }
  }
}
