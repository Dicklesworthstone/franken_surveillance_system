{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/sensor_capsule.v1.json",
  "title": "FSS Sensor Capsule v1",
  "$comment": "Mirrors SensorCapsuleV1 in crates/fss-core/src/sensor_capsule.rs field-for-field (pinned by crates/fss-core/tests/sensor_capsule_contract.rs). Rust length bounds count UTF-8 bytes while maxLength counts code points, so for non-ASCII text the Rust byte bound is the stricter, authoritative limit. integrity.metadataDigest is the fss.sensor_capsule.metadata.v1 digest of every capsule field except itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capsuleId",
    "sourceId",
    "deviceId",
    "adapterId",
    "sensorId",
    "streamId",
    "sourceIdentity",
    "deviceIdentity",
    "adapterIdentity",
    "sequence",
    "captureInterval",
    "receiveTimeNs",
    "clockBasis",
    "custody",
    "omission",
    "media",
    "integrity",
    "privacy",
    "publication"
  ],
  "anyOf": [
    {
      "$comment": "Retained under source custody...",
      "properties": {
        "custody": {
          "properties": {
            "isRetained": {
              "const": true
            }
          }
        }
      }
    },
    {
      "$comment": "...or carrying an explicit omission; never neither.",
      "properties": {
        "omission": {
          "properties": {
            "isOmitted": {
              "const": true
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "fss.sensor_capsule.v1"
    },
    "capsuleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sourceId": {
      "$comment": "Canonical form only: the alias prefix 'source:' is rejected.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!source:)[A-Za-z0-9_.:-]+$"
    },
    "deviceId": {
      "$comment": "Canonical form only: the alias prefix 'dev:' is rejected.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!dev:)[A-Za-z0-9_.:-]+$"
    },
    "adapterId": {
      "$comment": "Canonical form only: the alias prefix 'adp:' is rejected.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!adp:)[A-Za-z0-9_.:-]+$"
    },
    "sensorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "streamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sourceIdentity": {
      "allOf": [
        {
          "$ref": "source_identity.v1.json"
        },
        {
          "properties": {
            "sourceId": {
              "pattern": "^(?!source:)[A-Za-z0-9_.:-]+$"
            },
            "deviceId": {
              "pattern": "^(?!dev:)[A-Za-z0-9_.:-]+$"
            },
            "adapterId": {
              "pattern": "^(?!adp:)[A-Za-z0-9_.:-]+$"
            }
          }
        }
      ]
    },
    "deviceIdentity": {
      "allOf": [
        {
          "$ref": "device_identity.v1.json"
        },
        {
          "required": [
            "applicationVersion",
            "modelGeneration"
          ],
          "properties": {
            "deviceId": {
              "pattern": "^(?!dev:)[A-Za-z0-9_.:-]+$"
            }
          }
        }
      ]
    },
    "adapterIdentity": {
      "allOf": [
        {
          "$ref": "adapter_identity.v1.json"
        },
        {
          "properties": {
            "adapterId": {
              "pattern": "^(?!adp:)[A-Za-z0-9_.:-]+$"
            }
          }
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "captureInterval": {
      "$ref": "#/$defs/captureInterval"
    },
    "receiveTimeNs": {
      "type": "integer",
      "minimum": -170141183460469231731687303715884105728,
      "maximum": 170141183460469231731687303715884105727
    },
    "clockBasis": {
      "enum": [
        "utc_disciplined",
        "device_monotonic",
        "host_monotonic",
        "estimated"
      ]
    },
    "custody": {
      "$ref": "#/$defs/custody"
    },
    "omission": {
      "$ref": "#/$defs/omission"
    },
    "media": {
      "$ref": "#/$defs/media"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    }
  },
  "$defs": {
    "digest": {
      "$comment": "Shared by other FSS schemas; the capsule's own fields use the exact contentDigest grammar below.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[0-9a-f]{32,}$"
    },
    "contentDigest": {
      "$comment": "Exact grammar accepted by ContentDigest::parse.",
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "timeInterval": {
      "$comment": "Shared by other FSS schemas; the capsule uses captureInterval below.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliestNs",
        "latestNs",
        "uncertaintyReason"
      ],
      "properties": {
        "earliestNs": {
          "type": "integer"
        },
        "latestNs": {
          "type": "integer"
        },
        "uncertaintyReason": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "captureInterval": {
      "$comment": "CaptureInterval (i128 nanoseconds, earliestNs <= latestNs) plus SensorCapsuleV1.capture_uncertainty_reason.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliestNs",
        "latestNs",
        "uncertaintyReason"
      ],
      "properties": {
        "earliestNs": {
          "type": "integer",
          "minimum": -170141183460469231731687303715884105728,
          "maximum": 170141183460469231731687303715884105727
        },
        "latestNs": {
          "type": "integer",
          "minimum": -170141183460469231731687303715884105728,
          "maximum": 170141183460469231731687303715884105727
        },
        "uncertaintyReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRetained",
        "sourceBytes",
        "sourceDigest",
        "storageHandle"
      ],
      "properties": {
        "isRetained": {
          "type": "boolean"
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sourceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/contentDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "storageHandle": {
          "type": "string",
          "maxLength": 256
        }
      },
      "if": {
        "required": [
          "isRetained"
        ],
        "properties": {
          "isRetained": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "sourceDigest": {
            "$ref": "#/$defs/contentDigest"
          },
          "storageHandle": {
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "sourceBytes": {
            "const": 0
          },
          "sourceDigest": {
            "type": "null"
          },
          "storageHandle": {
            "const": ""
          }
        }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isOmitted",
        "omittedBytes",
        "omittedFrames",
        "policyRule",
        "reason"
      ],
      "properties": {
        "isOmitted": {
          "type": "boolean"
        },
        "omittedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "omittedFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "policyRule": {
          "type": "string",
          "maxLength": 256
        },
        "reason": {
          "enum": [
            "none",
            "privacy_redaction",
            "resource_pressure",
            "retention_policy",
            "capability_filtered",
            "transient_preview_only",
            "upstream_missing"
          ]
        }
      },
      "if": {
        "required": [
          "isOmitted"
        ],
        "properties": {
          "isOmitted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "policyRule": {
            "minLength": 1
          },
          "reason": {
            "not": {
              "const": "none"
            }
          }
        }
      },
      "else": {
        "properties": {
          "omittedBytes": {
            "const": 0
          },
          "omittedFrames": {
            "const": 0
          },
          "policyRule": {
            "const": ""
          },
          "reason": {
            "const": "none"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "container",
        "frameCount",
        "height",
        "kind",
        "proxyDigest",
        "sourceBytes",
        "sourceDigest",
        "width"
      ],
      "properties": {
        "kind": {
          "enum": [
            "video",
            "audio",
            "image",
            "metadata",
            "compound"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "container": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sourceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/contentDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "proxyDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/contentDigest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity",
        "decode",
        "firmwareFingerprint",
        "metadataDigest"
      ],
      "properties": {
        "metadataDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "continuity": {
          "enum": [
            "unverified",
            "verified",
            "gapped",
            "indeterminate"
          ]
        },
        "decode": {
          "enum": [
            "not_attempted",
            "verified",
            "concealed_errors",
            "failed"
          ]
        },
        "firmwareFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maskGeneration",
        "redactionState",
        "retentionClass"
      ],
      "properties": {
        "maskGeneration": {
          "anyOf": [
            {
              "$ref": "#/$defs/contentDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "redactionState": {
          "enum": [
            "not_required",
            "applied",
            "deferred",
            "failed_closed"
          ]
        },
        "retentionClass": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerRevision",
        "rootDigest",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "reserved",
            "materialized",
            "published",
            "aborted",
            "indeterminate"
          ]
        },
        "rootDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "ledgerRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    }
  }
}
