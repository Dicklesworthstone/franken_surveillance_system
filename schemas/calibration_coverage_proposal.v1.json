{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/franken_surveillance_system/schemas/calibration_coverage_proposal.v1.json",
  "title": "Full-camera calibrated coverage proposal diagnostics",
  "description": "Read-only diagnostics. Version-6 CoverageRecord receipts carry canonical evidence identities; this JSON is neither an absence certificate nor effect authority. Count sums and aggregate budget conservation are enforced by the producing Rust types.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "mode",
    "assessments",
    "work_units",
    "work_units_total",
    "work_units_remaining",
    "absence_claim_authorized",
    "positive_event_approvals_changed",
    "existing_coverage_retracted",
    "effect_authority",
    "claim"
  ],
  "properties": {
    "format": {
      "const": "fss.calibration_coverage_proposal.v1"
    },
    "mode": {
      "const": "lossless_per_zone_abstention"
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "work_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64000000
    },
    "work_units_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64000000
    },
    "work_units_remaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64000000
    },
    "absence_claim_authorized": {
      "const": false
    },
    "positive_event_approvals_changed": {
      "const": false
    },
    "existing_coverage_retracted": {
      "const": false
    },
    "effect_authority": {
      "const": false
    },
    "claim": {
      "const": "conditional_linearized_screen_not_coverage_or_physical_currency"
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "camera",
        "sensor_id",
        "calibration_digest",
        "input_digest",
        "privacy_binding_digest",
        "policy",
        "sigma_multiplier",
        "zones",
        "work_units",
        "work_units_remaining",
        "claim"
      ],
      "properties": {
        "format": {
          "const": "fss.calibration_camera_coverage.v1"
        },
        "camera": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "calibration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "privacy_binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy": {
          "const": "fss.calibration_coverage_guard.v1:full-camera-marginal:exact-ground-grid:radius-3:linearized-pixel-depth:half-open-image:closed-contour-vs-half-open-mask:all-samples-inside-unmasked:abstention-only"
        },
        "sigma_multiplier": {
          "const": 3
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zone_id",
              "samples",
              "requires_abstention",
              "counts"
            ],
            "properties": {
              "zone_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "samples": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "requires_abstention": {
                "type": "boolean"
              },
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inside_unmasked",
                  "outside_frustum",
                  "frustum_boundary",
                  "camera_plane_crossing",
                  "privacy_masked",
                  "privacy_boundary",
                  "mean_behind_camera"
                ],
                "properties": {
                  "inside_unmasked": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  },
                  "outside_frustum": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  },
                  "frustum_boundary": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  },
                  "camera_plane_crossing": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  },
                  "privacy_masked": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  },
                  "privacy_boundary": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  },
                  "mean_behind_camera": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                  }
                }
              }
            }
          }
        },
        "work_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64000000
        },
        "work_units_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64000000
        },
        "claim": {
          "const": "conditional_linearized_screen_not_coverage_or_physical_currency"
        }
      }
    }
  }
}
