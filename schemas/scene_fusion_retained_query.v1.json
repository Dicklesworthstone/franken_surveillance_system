{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/scene_fusion_retained_query.v1.json",
  "title": "Source-authenticated retained scene reconstruction selection",
  "description": "Bounded local control JSON, not durable source authority. At most four report/label/tracker recipes and 2048 total feature selections. Native validation additionally enforces nonzero SHA-256 handles, exact pins, one-to-one physical source mapping, full source observation membership, subrectangle containment, full conservative capture intervals and motion-specific solver bounds. Point modes admit at most 32 observations and a one-second capture hull; inferred motion admits 128 and sixty seconds. Clock, camera, image-domain and common-feature declarations remain assumptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session",
    "generation",
    "clock_evidence",
    "camera_rig_digest",
    "privacy_domain",
    "clock",
    "reference_time_ns",
    "selections",
    "camera_bindings",
    "hypotheses"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_fusion_retained_query.v1"
    },
    "session": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/id"
    },
    "generation": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "clock_evidence": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "camera_rig_digest": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "privacy_domain": {
      "$ref": "#/$defs/identity"
    },
    "clock": {
      "$ref": "#/$defs/identity"
    },
    "reference_time_ns": {
      "$ref": "#/$defs/u64"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "scene_handoffs_retained_query.v1.json#/$defs/selection"
      }
    },
    "camera_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection",
          "camera",
          "camera_generation",
          "calibration",
          "image_domain",
          "mapping_basis",
          "image_domain_basis"
        ],
        "properties": {
          "selection": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/id"
          },
          "camera": {
            "$ref": "#/$defs/identity"
          },
          "camera_generation": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
          },
          "calibration": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
          },
          "image_domain": {
            "$ref": "#/$defs/identity"
          },
          "mapping_basis": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
          },
          "image_domain_basis": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "association_evidence",
          "max_capture_span_ns",
          "motion",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_.-]+$"
          },
          "association_evidence": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
          },
          "max_capture_span_ns": {
            "$ref": "#/$defs/u64"
          },
          "motion": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "static"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "velocity_per_second",
                  "evidence"
                ],
                "properties": {
                  "kind": {
                    "const": "linear"
                  },
                  "velocity_per_second": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1000000000000.0,
                      "maximum": 1000000000000.0
                    }
                  },
                  "evidence": {
                    "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "max_capture_uncertainty_ns"
                ],
                "properties": {
                  "kind": {
                    "const": "infer_linear"
                  },
                  "max_capture_uncertainty_ns": {
                    "$ref": "#/$defs/u64"
                  }
                }
              }
            ]
          },
          "triangulation": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "min_views": {
                "$ref": "#/$defs/u64"
              },
              "max_outliers": {
                "$ref": "#/$defs/u64"
              },
              "max_reprojection_pixels": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              },
              "min_ray_angle_radians": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              },
              "max_distance": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              },
              "max_condition_number": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              },
              "max_iterations": {
                "$ref": "#/$defs/u64"
              },
              "max_speed": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              }
            }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selection",
                "segment",
                "detection_row",
                "capsule_digest",
                "pixel_min",
                "pixel_max",
                "visible_contact",
                "sigma_pixels",
                "contact_basis"
              ],
              "properties": {
                "selection": {
                  "$ref": "scene_handoffs_query.v1.json#/$defs/id"
                },
                "segment": {
                  "$ref": "#/$defs/u64"
                },
                "detection_row": {
                  "$ref": "#/$defs/u64"
                },
                "capsule_digest": {
                  "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
                },
                "pixel_min": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000.0,
                    "maximum": 1000000000000.0
                  }
                },
                "pixel_max": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000.0,
                    "maximum": 1000000000000.0
                  }
                },
                "visible_contact": {
                  "type": "boolean"
                },
                "sigma_pixels": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 1000
                },
                "contact_basis": {
                  "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "u64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      ],
      "description": "Exact u64; the native parser additionally checks the upper bound for decimal strings."
    },
    "identity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ],
      "description": "Exact nonzero u64, with the numeric upper bound checked by the native parser."
    }
  }
}
