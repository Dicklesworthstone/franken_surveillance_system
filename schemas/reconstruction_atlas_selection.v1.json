{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/reconstruction_atlas_selection.v1.json",
  "title": "fss.reconstruction_atlas_selection.v1",
  "description": "Explicit owner selections from a whole pinned native pair or multiview reconstruction. At most65536 UTF-8 bytes,1..128 landmarks; IDs require exact canonical unsigned decimal tokens/strings. Runtime checks exact u64/u32 bounds, unique hypothesis/landmark/physical-group, existing twin feature ordinal and native eligible geometry. Enduring-static declarations do not establish physical stability; no position, descriptor, source fact or error-bound overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "association_evidence",
    "landmarks"
  ],
  "properties": {
    "schema": {
      "const": "fss.reconstruction_atlas_selection.v1"
    },
    "association_evidence": {
      "$ref": "#/$defs/digest"
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis",
          "landmark",
          "physical_group",
          "feature",
          "enduring_static_basis"
        ],
        "properties": {
          "hypothesis": {
            "$ref": "#/$defs/digest"
          },
          "landmark": {
            "$ref": "#/$defs/identity"
          },
          "physical_group": {
            "$ref": "#/$defs/identity"
          },
          "feature": {
            "$ref": "#/$defs/feature"
          },
          "enduring_static_basis": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "identity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        }
      ]
    },
    "feature": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295)$"
        }
      ]
    }
  }
}
