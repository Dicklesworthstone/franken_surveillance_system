{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/package_zone_report.v1.json",
  "title": "FSS retained package-track image zones and sampled dwell v1",
  "description": "Complete source-verified native projection. Schema validation checks representation, not custody. The native owner additionally verifies exact source/model/class/tracker/privacy bindings, all frame/track/zone references, aggregate track × zone × frame work, canonical replay, capture intervals and current retention/deletion. Image-zone observations never grant calibrated class, physical identity, continuous occupancy, absence, source health or effect authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "report_digest",
    "provenance_root",
    "configuration_digest",
    "approval_digest",
    "retained",
    "retention_anchor",
    "source",
    "configuration",
    "frames",
    "tracks",
    "cells",
    "events",
    "semantics"
  ],
  "properties": {
    "schema": {
      "const": "fss.package_zone_report.v1"
    },
    "operation": {
      "enum": [
        "analyzed",
        "retained",
        "already_retained",
        "read_verified"
      ]
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    },
    "provenance_root": {
      "$ref": "#/$defs/digest"
    },
    "configuration_digest": {
      "$ref": "#/$defs/digest"
    },
    "approval_digest": {
      "$ref": "#/$defs/digest"
    },
    "retained": {
      "type": "boolean"
    },
    "retention_anchor": {
      "anyOf": [
        {
          "$ref": "#/$defs/anchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "import_identity",
        "import_root",
        "package_report",
        "analysis_digest",
        "package_digest",
        "model_id",
        "generation",
        "contract_digest",
        "label",
        "class_index",
        "capture_time_label",
        "clock_basis",
        "privacy_binding",
        "source_anchor"
      ],
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "import_identity": {
          "$ref": "#/$defs/digest"
        },
        "import_root": {
          "$ref": "#/$defs/digest"
        },
        "package_report": {
          "$ref": "#/$defs/digest"
        },
        "analysis_digest": {
          "$ref": "#/$defs/digest"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "class_index": {
          "type": "integer",
          "minimum": 0
        },
        "capture_time_label": {
          "type": "string",
          "minLength": 1
        },
        "clock_basis": {
          "enum": [
            "utc_disciplined",
            "device_monotonic",
            "host_monotonic",
            "estimated"
          ]
        },
        "privacy_binding": {
          "$ref": "#/$defs/digest"
        },
        "source_anchor": {
          "$ref": "#/$defs/anchor"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_hits",
        "maximum_missed_frames",
        "minimum_iou_ppm",
        "maximum_sample_gap_ns",
        "dwell",
        "zones"
      ],
      "properties": {
        "confirmation_hits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "maximum_missed_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minimum_iou_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximum_sample_gap_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000000000
        },
        "dwell": {
          "anyOf": [
            {
              "$ref": "#/$defs/dwell"
            },
            {
              "type": "null"
            }
          ]
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          },
          "minItems": 1,
          "maxItems": 16
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      },
      "minItems": 0,
      "maxItems": 8192
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      },
      "minItems": 0,
      "maxItems": 8192
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "maxItems": 16384
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrated",
        "continuous_occupancy",
        "absence_authorized",
        "effects_authorized",
        "source_health_assessed"
      ],
      "properties": {
        "calibrated": {
          "const": false
        },
        "continuous_occupancy": {
          "const": false
        },
        "absence_authorized": {
          "const": false
        },
        "effects_authorized": {
          "const": false
        },
        "source_health_assessed": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retained": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "retention_anchor": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "retention_anchor": {
            "$ref": "#/$defs/anchor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "retained",
              "already_retained",
              "read_verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "retained": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signedNanoseconds": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "unsignedNanoseconds": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "zoneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_lineage",
        "ledger_epoch",
        "commit_sequence",
        "adapter_registry_epoch",
        "schema_epoch",
        "policy_epoch",
        "privacy_epoch",
        "state_root"
      ],
      "properties": {
        "site_lineage": {
          "type": "string",
          "minLength": 1
        },
        "ledger_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "adapter_registry_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "schema_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "privacy_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "state_root": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest_ns",
        "latest_ns"
      ],
      "properties": {
        "earliest_ns": {
          "$ref": "#/$defs/signedNanoseconds"
        },
        "latest_ns": {
          "$ref": "#/$defs/signedNanoseconds"
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height",
        "margin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/zoneId"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "margin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "dwell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_duration_ns",
        "minimum_observations"
      ],
      "properties": {
        "minimum_duration_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000000000
        },
        "minimum_observations": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment",
        "capsule_digest",
        "capture",
        "dimensions",
        "time_reliable",
        "source_boundary"
      ],
      "properties": {
        "segment": {
          "type": "integer",
          "minimum": 0
        },
        "capsule_digest": {
          "$ref": "#/$defs/digest"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "minItems": 2,
          "maxItems": 2
        },
        "time_reliable": {
          "type": "boolean"
        },
        "source_boundary": {
          "type": "boolean"
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "track_id",
        "ever_confirmed"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/digest"
        },
        "track_id": {
          "type": "integer",
          "minimum": 0
        },
        "ever_confirmed": {
          "type": "boolean"
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "zone",
        "frame",
        "relation",
        "sample_confirmed",
        "detection_row",
        "bounds",
        "clipped"
      ],
      "properties": {
        "track": {
          "$ref": "#/$defs/digest"
        },
        "zone": {
          "$ref": "#/$defs/zoneId"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "relation": {
          "enum": [
            "inside",
            "outside",
            "boundary",
            "partial",
            "unobserved",
            "masked"
          ]
        },
        "sample_confirmed": {
          "type": "boolean"
        },
        "detection_row": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "bounds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "clipped": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "track",
        "zone",
        "from_frame",
        "at_frame",
        "through_frame",
        "observations",
        "minimum_duration_ns",
        "maximum_duration_ns"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observed_inside",
            "entered_between_observations",
            "left_between_observations",
            "observation_interrupted",
            "sampled_dwell"
          ]
        },
        "track": {
          "$ref": "#/$defs/digest"
        },
        "zone": {
          "$ref": "#/$defs/zoneId"
        },
        "from_frame": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            {
              "type": "null"
            }
          ]
        },
        "at_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "through_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "minimum_duration_ns": {
          "anyOf": [
            {
              "$ref": "#/$defs/unsignedNanoseconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_duration_ns": {
          "anyOf": [
            {
              "$ref": "#/$defs/unsignedNanoseconds"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
