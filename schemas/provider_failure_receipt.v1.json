{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/provider_failure_receipt.v1.json",
  "title": "FSS Provider Failure Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "errorCode",
    "idempotencyKey",
    "messageDigest",
    "preparedEffectDigest",
    "providerNonce",
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "fss.provider_failure_receipt.v1"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "providerNonce": {
      "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
    },
    "messageDigest": {
      "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
    },
    "preparedEffectDigest": {
      "$ref": "sensor_capsule.v1.json#/$defs/contentDigest"
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
