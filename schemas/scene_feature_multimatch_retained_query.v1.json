{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scene_feature_multimatch_retained_query.v1.json",
  "title": "fss.scene_feature_multimatch_retained_query.v1",
  "description": "Three through eight exact retained camera-frame selections for automatic native static-feature association and joint geometry. Each source has the same sealed JPEG/AVC/HEVC custody, current privacy, full capture and declared mapping/alignment contract as retained-match. All logical cameras, retained sensor IDs, encoded sources and exposures must be distinct. Native binding checks at most 256 actual selected features before pair expansion; maximum_features remains a per-view upper bound, not permission to truncate the aggregate. Complete global capture hull is at most one second and contains the requested reference. Each pair/component explicitly records that requested time and its clamp into the subset full hull under the declared static-scene assumption. Joint solves require every component member, one feature per camera, complete direct pair support and zero outlier removal. Input declarations cannot override source capture, pixels, dimensions or privacy, activate calibration or establish physical identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "camera_rig_digest",
    "privacy_domain",
    "clock",
    "clock_evidence",
    "association_basis",
    "reference_time_ns",
    "max_capture_span_ns",
    "motion",
    "views",
    "extraction",
    "matching"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_feature_multimatch_retained_query.v1"
    },
    "camera_rig_digest": {
      "$ref": "#/$defs/digest"
    },
    "privacy_domain": {
      "$ref": "#/$defs/identity"
    },
    "clock": {
      "$ref": "#/$defs/identity"
    },
    "clock_evidence": {
      "$ref": "#/$defs/digest"
    },
    "association_basis": {
      "$ref": "#/$defs/digest"
    },
    "reference_time_ns": {
      "$ref": "#/$defs/u64"
    },
    "max_capture_span_ns": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})$"
        }
      ]
    },
    "motion": {
      "const": "static_during_capture_hull"
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "maximum_features",
        "separation"
      ],
      "properties": {
        "threshold": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 254
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}$"
            }
          ]
        },
        "maximum_features": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}$"
            }
          ]
        },
        "separation": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}$"
            }
          ]
        }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_hamming_distance",
        "ratio_percent",
        "maximum_epipolar_distance_pixels"
      ],
      "properties": {
        "maximum_hamming_distance": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,2})$"
            }
          ]
        },
        "ratio_percent": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,1}$"
            }
          ]
        },
        "maximum_epipolar_distance_pixels": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000
        }
      }
    },
    "triangulation": {
      "$ref": "#/$defs/triangulation"
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      },
      "minItems": 3,
      "maxItems": 8
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "image_domain_digest",
        "mapping_basis",
        "sigma_pixels",
        "source",
        "alignment"
      ],
      "properties": {
        "camera": {
          "$ref": "#/$defs/identity"
        },
        "image_domain_digest": {
          "$ref": "#/$defs/digest"
        },
        "mapping_basis": {
          "$ref": "#/$defs/digest"
        },
        "sigma_pixels": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "alignment": {
          "$ref": "#/$defs/alignment"
        }
      }
    },
    "triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "min_views": {
          "enum": [
            2,
            "2"
          ]
        },
        "max_outliers": {
          "enum": [
            0,
            "0"
          ]
        },
        "max_reprojection_pixels": {
          "type": "number",
          "minimum": 0
        },
        "min_ray_angle_radians": {
          "type": "number",
          "minimum": 0
        },
        "max_distance": {
          "type": "number",
          "minimum": 0
        },
        "max_condition_number": {
          "type": "number",
          "minimum": 1
        },
        "max_iterations": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,1}$"
            }
          ]
        }
      }
    },
    "i64": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]{0,18})$"
        }
      ],
      "description": "Canonical exact signed decimal literal; native validation enforces i64 bounds and refuses negative zero."
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "import_identity",
            "segment",
            "capsule_digest",
            "encoded_source_digest",
            "sensor_id",
            "component_interpretation"
          ],
          "properties": {
            "codec": {
              "const": "jpeg"
            },
            "import_identity": {
              "$ref": "#/$defs/digest"
            },
            "segment": {
              "$ref": "#/$defs/u64"
            },
            "capsule_digest": {
              "$ref": "#/$defs/digest"
            },
            "encoded_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "sensor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "component_interpretation": {
              "enum": [
                "grayscale",
                "ycbcr"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "import_identity",
            "segment",
            "capsule_digest",
            "encoded_source_digest",
            "sensor_id",
            "first_segment",
            "segment_count"
          ],
          "properties": {
            "codec": {
              "const": "h264"
            },
            "import_identity": {
              "$ref": "#/$defs/digest"
            },
            "segment": {
              "$ref": "#/$defs/u64"
            },
            "capsule_digest": {
              "$ref": "#/$defs/digest"
            },
            "encoded_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "sensor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "first_segment": {
              "$ref": "#/$defs/u64"
            },
            "segment_count": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                {
                  "type": "string",
                  "pattern": "^([1-9]|[1-5][0-9]|6[0-4])$"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "import_identity",
            "segment",
            "capsule_digest",
            "encoded_source_digest",
            "sensor_id",
            "first_segment",
            "segment_count"
          ],
          "properties": {
            "codec": {
              "const": "h265"
            },
            "import_identity": {
              "$ref": "#/$defs/digest"
            },
            "segment": {
              "$ref": "#/$defs/u64"
            },
            "capsule_digest": {
              "$ref": "#/$defs/digest"
            },
            "encoded_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "sensor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "first_segment": {
              "$ref": "#/$defs/u64"
            },
            "segment_count": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                {
                  "type": "string",
                  "pattern": "^([1-9]|[1-5][0-9]|6[0-4])$"
                }
              ]
            }
          }
        }
      ]
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_identity",
        "stream_id",
        "clock_basis",
        "offset_ns",
        "basis"
      ],
      "properties": {
        "import_identity": {
          "$ref": "#/$defs/digest"
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "clock_basis": {
          "enum": [
            "utc_disciplined",
            "device_monotonic",
            "host_monotonic",
            "estimated"
          ]
        },
        "offset_ns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/i64"
          }
        },
        "basis": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
