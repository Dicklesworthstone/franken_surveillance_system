{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/agent_finding.v1.json",
  "title": "Agent Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractBasis",
    "findingId",
    "missionId",
    "branchId",
    "authorPrincipalId",
    "anchor",
    "questionOrClaim",
    "epistemicState",
    "supportingEvidence",
    "contradictoryEvidence",
    "assumptions",
    "coverage",
    "methodReceipts",
    "affectedObjects",
    "suggestedFollowUp",
    "createdAtNs"
  ],
  "properties": {
    "schema": {
      "const": "fss.agent_finding.v1"
    },
    "findingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "branchId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorPrincipalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
    },
    "anchor": {
      "$ref": "evidence_anchor.v1.json"
    },
    "questionOrClaim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "epistemicState": {
      "enum": [
        "known",
        "estimated",
        "unknown",
        "conflicted",
        "stale",
        "not_observable",
        "redacted",
        "indeterminate",
        "not_applicable"
      ]
    },
    "supportingEvidence": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "contradictoryEvidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statementId",
          "text",
          "epistemicState",
          "basis"
        ],
        "properties": {
          "statementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "epistemicState": {
            "enum": [
              "known",
              "estimated",
              "unknown",
              "conflicted",
              "stale",
              "not_observable",
              "redacted",
              "indeterminate",
              "not_applicable"
            ]
          },
          "basis": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "contradictions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
            }
          },
          "validUntilNs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "methodReceipts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "calibrationBasis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "affectedObjects": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "suggestedFollowUp": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "withdrawn": {
      "type": "boolean"
    },
    "createdAtNs": {
      "type": "integer",
      "minimum": 0
    },
    "contractBasis": {
      "$ref": "agent_contract_basis.v1.json"
    }
  }
}
