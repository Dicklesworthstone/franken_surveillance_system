          "$ref": "scene_feature_match_adopted.v2.json#/$defs/cost/properties/video_admission"
        },
        "unmeasured": {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/cost/properties/unmeasured"
        },
        "calibration_input_bytes": {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/cost/properties/calibration_input_bytes"
        },
        "calibration_authority_bytes": {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/cost/properties/calibration_authority_bytes"
        },
        "clock_query_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowance",
            "used",
            "reserved_from_source_bytes"
          ],
          "properties": {
            "allowance": {
              "const": "1048576"
            },
            "used": {
              "$ref": "scene_feature_match_adopted.v2.json#/$defs/u64"
            },
            "reserved_from_source_bytes": {
              "const": true
            }
          },
          "description": "Complete original clock sidecar bytes read once under the same authority; its entire 1 MiB maximum is reserved from original source reads, whose remaining allowance also includes final revalidation."
        }
      }
    }
  }
}
