{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scene_feature_match_adopted.v3.json",
  "title": "fss.scene_feature_match_adopted.v3",
  "description": "Explicit currently adopted camera temporal reconstruction with original finite clock-query replay. Accepts only retained-motion query v2 and exact adopted rig v1/v2. Original clock cameras must bind the semantic FSSCAL digest, current adopted sensors, actual poses/intrinsics and prepared image domains. Every declared offset/skew hypothesis remains in mapped exposure envelopes, including conditionally unsupported alternatives; exact original retained intervals, uncertainty, validity, span and requested time are checked before source decode. Complete adopted calibration, source receipts, native geometry, original clock query and replay remain visible. Shared work/cancellation and existing aggregate source-byte authority are preserved; source/privacy and adoption/withdrawal custody revalidate before release. Clock-search/validation observations remain declarations with unverified source custody. No clock, calibration, world revision, identity or effect is activated; absolute error remains unknown. Report digest is SHA-256 over the exact nested report UTF-8 bytes; the complete response plus newline is limited to 32 MiB. Existing adopted report v1/v2 contracts remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_digest",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_feature_match_adopted.v3"
    },
    "report_digest": {
      "$ref": "scene_feature_match_adopted.v2.json#/$defs/digest"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "analysis",
        "cost"
      ],
      "properties": {
        "schema": {
          "const": "fss.scene_feature_match_adopted_report.v3"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        }
      }
    }
  },
  "$defs": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome",
        "authority",
        "physical_identity_established",
        "query_digest",
        "rig_digest",
        "reference_time_ns",
        "capture_hull_ns",
        "entry_anchor_digest",
        "entry_anchor",
        "anchor_digest",
        "anchor",
        "basis",
        "calibration",
        "declarations",
        "rig_declarations",
        "assumptions",
        "views",
        "geometry",
        "counts",
        "clock_validation"
      ],
      "properties": {
