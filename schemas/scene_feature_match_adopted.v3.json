        },
        "entry_anchor_digest": {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/analysis/properties/entry_anchor_digest"
        },
        "entry_anchor": {
          "$ref": "scene_feature_match_adopted.v2.json#/$defs/analysis/properties/entry_anchor"
