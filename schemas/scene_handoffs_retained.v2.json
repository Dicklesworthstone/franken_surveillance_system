{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/scene_handoffs_retained.v2.json",
  "title": "Complete retained handoff report with conservative native clock replay",
  "description": "The original authenticated local-time source projection is separate from derived common-clock captures. Every original clock hypothesis, all original query bytes, complete native diagnostics, every selected observation, and full native handoff alternatives are retained. No clock activation, physical identity, camera calibration or clock-observation custody is certified. Exact interval/scope checks and ordered complete observations are enforced by native admission. Maximum complete output is 4 MiB including newline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome",
    "authority",
    "source_provenance",
    "physical_identity_established",
    "clock_activated",
    "clock_observation_custody_verified",
    "input_document_digest",
    "projection_digest",
    "world_basis",
    "anchor_digest",
    "anchor",
    "source_projection",
    "derived_clock_bindings",
    "clock_validation",
    "assumptions",
    "work_used",
    "work_remaining",
    "conditional_analysis"
  ],
  "properties": {
    "schema": {
      "const": "fss.scene_handoffs_retained.v2"
    },
    "outcome": {
      "const": "completed"
    },
    "authority": {
      "const": "derived_cognition_no_effect_authority"
    },
    "source_provenance": {
      "const": "verified_retained_package_observations"
    },
    "physical_identity_established": {
      "const": false
    },
    "clock_activated": {
      "const": false
    },
    "clock_observation_custody_verified": {
      "const": false
    },
    "input_document_digest": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "projection_digest": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "world_basis": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "anchor_digest": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
    },
    "anchor": {
      "$ref": "scene_handoffs_retained.v1.json#/$defs/anchor"
    },
    "source_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "time_interpretation",
        "bindings"
      ],
      "properties": {
        "digest": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
        },
        "time_interpretation": {
          "const": "identity_mapping_preserves_original_local_capture_only"
        },
        "bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "scene_handoffs_retained.v1.json#/$defs/binding"
          }
        }
      }
    },
    "derived_clock_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/mapped_track"
      }
    },
    "clock_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_digest",
        "reference",
        "target",
        "original_query_json",
        "original_query",
        "native_replay"
      ],
      "properties": {
        "query_digest": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
        },
        "reference": {
          "$ref": "scene_handoffs_retained_query.v2.json#/$defs/stream"
        },
        "target": {
          "$ref": "scene_handoffs_retained_query.v2.json#/$defs/stream"
        },
        "original_query": {
          "$ref": "clock_validation_query.v1.json"
        },
        "native_replay": {
          "$ref": "clock_validation_replay_response.v1.json"
        },
        "original_query_json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "description": "Exact original UTF-8 query bytes after JSON string decoding, including whitespace and final newline. SHA-256 of these UTF-8 bytes equals query_digest."
        }
      }
    },
    "assumptions": {
      "const": [
        "clock_query_observation_pins_and_camera_clock_associations_are_operator_declarations",
        "all_declared_clock_candidates_remain_in_every_target_time_envelope",
        "clock_session_containment_is_not_physical_clock_validity_or_source_coverage",
        "calibration_and_image_domain_pins_bind_declared_scope_without_authenticating_geometry",
        "transition_costs_and_transit_bounds_are_operator_declarations",
        "source_custody_does_not_establish_detector_accuracy_or_physical_identity"
      ]
    },
    "work_used": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/u64"
    },
    "work_remaining": {
      "$ref": "scene_handoffs_query.v1.json#/$defs/u64"
    },
    "conditional_analysis": {
      "$ref": "scene_handoffs.v1.json"
    }
  },
  "$defs": {
    "mapped_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capsule_digest",
        "original_capture_ns",
        "common_capture_ns",
        "projection_id",
        "containing_session_ids"
      ],
      "properties": {
        "capsule_digest": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/digest"
        },
        "original_capture_ns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": -170141183460469231731687303715884105728,
            "maximum": 170141183460469231731687303715884105727
          }
        },
        "common_capture_ns": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/clock_interval"
        },
        "projection_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "containing_session_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 9,
          "items": {
            "$ref": "scene_handoffs_query.v1.json#/$defs/u64"
          }
        }
      }
    },
    "mapped_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observations"
      ],
      "properties": {
        "id": {
          "$ref": "scene_handoffs_query.v1.json#/$defs/id"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/mapped_observation"
          }
        }
      }
    }
  }
}
