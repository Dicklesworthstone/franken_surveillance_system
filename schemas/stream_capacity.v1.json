            "decisionPathDigest": {
              "$ref": "#/$defs/sha256"
            },
            "outputDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "minimum_cost_witness": {
      "allOf": [
        {
          "$ref": "graph_algorithm_witness.v1.json"
        },
        {
          "properties": {
            "algorithmId": {
              "const": "ALG-MCF-001"
            },
            "implementationId": {
              "const": "fss-graph-algorithms:alg-mcf-001:successive-shortest-path-potentials-certified:v1"
            },
            "projectionId": {
              "type": "string",
              "pattern": "^DeviceFailureGraph@coverage:sha256:[0-9a-f]{64}/minimum-cost$"
            },
            "anchor": {
              "$ref": "evidence_anchor.v1.json"
            },
            "nodeCount": {
              "type": "integer",
              "minimum": 5,
              "maximum": 1442
            },
            "edgeCount": {
              "type": "integer",
              "minimum": 4,
              "maximum": 2368
            },
            "inputDigest": {
              "$ref": "#/$defs/sha256"
