              "type": "integer",
              "minimum": 5,
              "maximum": 1442
            },
            "edgeCount": {
              "type": "integer",
              "minimum": 4,
              "maximum": 2368
            },
            "inputDigest": {
              "$ref": "#/$defs/sha256"
            },
            "policyId": {
              "const": "graph-policy:directed-or-undirected:simple-strict:arc-capacity-or-node-failure-weight:numeric:u64-exact:checked:unit-bound:v1:tie:canonical-arc-order-residual-edges-forward-before-reverse:v1"
            },
            "dominantOperationCounts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "augmentations",
                "residual_scans",
                "path_steps",
                "certificate_checks"
              ],
              "properties": {
                "augmentations": {
                  "$ref": "#/$defs/u64"
                },
                "residual_scans": {
                  "$ref": "#/$defs/u64"
                },
                "path_steps": {
                  "$ref": "#/$defs/u64"
                },
                "certificate_checks": {
                  "$ref": "#/$defs/u64"
                }
              }
            },
            "peakWorkingBytes": {
              "$ref": "#/$defs/u64"
            },
            "budgetConsumed": {
