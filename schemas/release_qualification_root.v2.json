{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.invalid/schemas/release_qualification_root.v2.json",
  "title": "Per-target release qualification root v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "target",
    "sourceCommit",
    "sourceDateEpoch",
    "primaryArtifact",
    "supportArtifacts",
    "stageFileCount",
    "commonAssetAuthority",
    "claimBoundary",
    "signatureState"
  ],
  "properties": {
    "schema": {
      "const": "fss.qualification_root.v2"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "primaryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/\\\\]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "supportArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^/\\\\]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "uniqueItems": true
    },
    "stageFileCount": {
      "type": "integer",
      "minimum": 1
    },
    "claimBoundary": {
      "enum": [
        "implementation-status-design-skeleton",
        "operational-candidate",
        "qualified-release"
      ]
    },
    "signatureState": {
      "enum": [
        "unsigned-awaiting-separated-dsr-signing-authority",
        "signed-and-verified",
        "signature-not-required-by-policy"
      ]
    },
    "commonAssetAuthority": {
      "type": "boolean"
    }
  }
}
