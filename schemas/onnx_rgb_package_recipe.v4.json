{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/onnx_rgb_package_recipe.v4.json",
  "title": "fss.onnx_rgb_package_recipe.v4",
  "description": "Explicit local detector recipe v4: all v2 image preprocessing choices plus assembly of two named static F32 batch-one box/score outputs. Each source layout is explicit. Boxes have exactly four fields, score width is 1..257, row counts must match and be 1..32768. Unique source class indices select and reorder score columns into label order; the index count must equal the label count and every index must be below the actual score width. A distinct rows output is appended with four box fields followed by the selected scores. Original outputs and parameters are retained; only existing Transpose, Slice and Concat operations are added. Boxes and probability/logit semantics remain explicit in head; no activation, background rule, objectness or model family is inferred. DFL decoding and split-head assembly cannot be combined. Native validation additionally enforces exact shapes, aggregate outputs, graph/name bounds, quotas, pins, licensing and cancellation. This is numerical wiring support, not model-quality or family qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "model_id",
    "model_generation",
    "tensor_generation",
    "preprocess",
    "head",
    "labels",
    "source",
    "license",
    "head_assembly"
  ],
  "properties": {
    "format": {
      "const": "fss.onnx_rgb_package_recipe.v4"
    },
    "model_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^MOD-[A-Z0-9-]+$"
    },
    "model_generation": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^(?!.*latest)[a-z0-9][a-z0-9:+._-]{7,255}$"
    },
    "tensor_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_input",
        "height",
        "width",
        "resize",
        "letterbox_pad",
        "masked_rgb",
        "scale_to_unit",
        "channel_order",
        "mean",
        "standard_deviation"
      ],
      "properties": {
        "image_input": {
          "$ref": "#/$defs/text512"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "resize": {
          "enum": [
            "nearest",
            "bilinear"
          ]
        },
        "letterbox_pad": {
          "$ref": "#/$defs/byte"
        },
        "masked_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "scale_to_unit": {
          "type": "boolean"
        },
        "channel_order": {
          "enum": [
            "rgb",
            "bgr"
          ],
          "description": "Explicit model-input channel order after native RGB scaling; never inferred."
        },
        "mean": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38
          },
          "description": "Finite F32 subtraction values in model-input channel order, using the units selected by scale_to_unit."
        },
        "standard_deviation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3.4028234663852886e+38
          },
          "description": "Strictly positive finite F32 divisors. Native validation rejects values rounding to zero and normalization overflow."
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_port",
        "layout",
        "boxes",
        "class_score",
        "objectness",
        "classes",
        "minimum_score_ppm",
        "nms_iou_ppm",
        "maximum_rows",
        "maximum_candidates",
        "maximum_detections"
      ],
      "properties": {
        "output_port": {
          "$ref": "#/$defs/text128"
        },
        "layout": {
          "const": "rows"
        },
        "boxes": {
          "enum": [
            "pixel-corners",
            "pixel-center-size",
            "normalized-corners",
            "normalized-center-size"
          ]
        },
        "class_score": {
          "enum": [
            "probability",
            "logit"
          ]
        },
        "objectness": {
          "const": "none"
        },
        "classes": {
          "enum": [
            "best",
            "multi-label"
          ]
        },
        "minimum_score_ppm": {
          "$ref": "#/$defs/ppm"
        },
        "nms_iou_ppm": {
          "$ref": "#/$defs/ppm"
        },
        "maximum_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maximum_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximum_detections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text128"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "revision",
        "producer"
      ],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/text256"
        },
        "revision": {
          "$ref": "#/$defs/text128"
        },
        "producer": {
          "$ref": "#/$defs/text512"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "use_approved",
        "restrictions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text128"
        },
        "use_approved": {
          "type": "boolean",
          "description": "Explicit operator decision; the existing surveillance-monitoring license policy still decides whether packaging is admitted."
        },
        "restrictions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text256"
          }
        }
      }
    },
    "head_assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "boxes_output",
        "boxes_layout",
        "scores_output",
        "scores_layout",
        "class_indices"
      ],
      "properties": {
        "kind": {
          "const": "split-boxes-scores"
        },
        "boxes_output": {
          "$ref": "#/$defs/text512",
          "description": "Declared source output with four box fields; distinct from scores_output and head.output_port."
        },
        "boxes_layout": {
          "enum": [
            "rows",
            "channels"
          ],
          "description": "rows is [1,N,4]; channels is [1,4,N]."
        },
        "scores_output": {
          "$ref": "#/$defs/text512",
          "description": "Declared source output containing the explicit source class columns."
        },
        "scores_layout": {
          "enum": [
            "rows",
            "channels"
          ],
          "description": "rows is [1,N,C]; channels is [1,C,N], with 1..257 source columns."
        },
        "class_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          },
          "description": "Zero-based source score columns, exactly one per label in label order. Unselected columns are excluded deliberately, never by an inferred background convention. Native validation requires each index below the source score width."
        }
      }
    }
  },
  "$defs": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "text128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "text256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "text512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  }
}
