{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franken-surveillance-system.dev/schemas/prepared_effect.v1.json",
  "title": "FSS Prepared Effect v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "obligationId",
    "preparedAt",
    "schema",
    "terminalPredicate"
  ],
  "properties": {
    "schema": {
      "const": "fss.prepared_effect.v1"
    },
    "intent": {
      "$ref": "effect_intent.v1.json"
    },
    "obligationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "terminalPredicate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "preparedAt": {
      "type": "integer",
      "minimum": 0
    }
  }
}
