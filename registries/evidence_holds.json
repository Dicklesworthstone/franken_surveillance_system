  "cost": {"hold_index": "scan committed deltas; at most 512 hold records", "deletion": "one bounded universe scan; at most 32 distinct held-closure computations per candidate import", "deadline_evaluation": "constant work per hold; comparisons without subtraction", "wall_time_slo": "unmeasured"},
  "compatibility": "No-hold plans and indefinite v1 record bytes/approvals unchanged. V1 hold readers reject v2 deadlines. All deletion writers must be hold-aware; pre-hold binaries and mixed-version downgrade remain unsupported.",
  "tests": ["crates/fss-reference/tests/evidence_hold_contract.rs", "crates/fss-cli/tests/evidence_hold_cli_contract.rs", "crates/fss-reference/src/deletion/holds/state.rs", "crates/fss-reference/tests/fixtures/retention_deadline_model.py", "crates/fss-reference/tests/retention_deadline_contract.rs", "crates/fss-cli/tests/retention_deadline_cli_contract.rs"],
