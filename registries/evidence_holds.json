  "transitions": [{"from": "absent", "to": "held", "generation": 1}, {"from": "held", "to": "released", "generation": 2}, {"from": "absent", "to": "retained_until", "generation": 1}, {"from": "retained_until", "to": "expired", "generation": 2, "guard": "same_deadline_and_earliest_attested_now_at_or_after_not_before"}],
