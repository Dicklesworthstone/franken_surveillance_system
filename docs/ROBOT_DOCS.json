  "errors": [
    {
      "description": "recommended next move lost a precondition, capability, lease, or validity interval",
      "guidance": "refresh/replan; never execute cached recommendation",
      "id": "ERR-AGENT-AFFORDANCE-INVALIDATED-001"
    },
    {
      "description": "natural-language request has multiple materially different interpretations",
      "guidance": "return interpretations; choose only a registered safe-read default or request clarification",
      "id": "ERR-AGENT-AMBIGUOUS-001"
    },
    {
      "description": "investigation cannot discriminate remaining hypotheses within declared budget",
      "guidance": "return residual uncertainty and explicit next probe/approval options",
      "id": "ERR-AGENT-CASE-BUDGET-001"
    },
    {
      "description": "requested decision-complete context cannot fit or lacks required evidence",
      "guidance": "return bounded partial with omissions/expansion handles; never imply completeness",
      "id": "ERR-AGENT-CONTEXT-INCOMPLETE-001"
    },
    {
      "description": "handoff root is incomplete, expired, unauthorized, schema/generation-incompatible, or cannot be safely rebased",
      "guidance": "reject, migrate, or open a new session with an explicit invalidation report; never silently resume",
      "id": "ERR-AGENT-HANDOFF-INVALID-001"
    },
    {
      "description": "learning proposal lacks evidence, applicability, counterexamples, or validation path",
      "guidance": "retain as rejected/advisory; do not activate",
      "id": "ERR-AGENT-LEARNING-UNSUPPORTED-001"
    },
    {
      "description": "no safe, authorized, useful next action exists under current evidence/budget",
      "guidance": "explain blocking clamps and return wait/escalate/stop reason",
      "id": "ERR-AGENT-NO-AFFORDANCE-001"
    },
    {
      "description": "presentation attempted an unregistered verb/view or changed semantic meaning",
      "guidance": "reject and repair registry/transport drift",
      "id": "ERR-AGENT-PROTOCOL-001"
    },
    {
      "description": "continuation cannot advance coherently from its exact basis",
      "guidance": "request a fresh situation capsule; do not splice generations",
      "id": "ERR-AGENT-RESNAPSHOT-001"
    },
    {
      "description": "external effects/obligations prevent a truthful resumed terminal state",
      "guidance": "resume in reconciliation mode; no effect retry before lookup/proof",
      "id": "ERR-AGENT-RESUME-INDETERMINATE-001"
    },
    {
      "description": "session, workspace, or resumed handoff basis no longer satisfies required anchor/generation/freshness semantics",
      "guidance": "rebase and enumerate every invalidated assumption, alias, grant, lease, plan, continuation, and affordance before proceeding",
      "id": "ERR-AGENT-SESSION-STALE-001"
    },
    {
      "description": "requested multi-agent work scope overlaps an incompatible live claim, lease, or fence",
      "guidance": "narrow, wait, delegate, release, or supersede with explicit authority; never last-writer-wins",
      "id": "ERR-AGENT-WORK-CLAIM-CONFLICT-001"
    },
    {
      "description": "principal lacks exact capability",
      "guidance": "do not retry without new authority",
      "id": "ERR-AUTH-DENIED-001"
    },
    {
      "description": "declared work budget exhausted",
      "guidance": "return bounded partial/abstention",
      "id": "ERR-BUDGET-EXHAUSTED-001"
    },
    {
      "description": "runtime error occurred during validated command execution",
      "guidance": "inspect diagnostic and address failure cause",
      "id": "ERR-CLI-RUNTIME-FAILURE-001"
    },
    {
      "description": "capture interval too wide for requested operation",
      "guidance": "degrade/abstain/recalibrate",
      "id": "ERR-CLOCK-UNCERTAIN-001"
    },
    {
      "description": "dispatch outcome cannot be determined",
      "guidance": "reconcile before retry",
      "id": "ERR-EFFECT-INDETERMINATE-001"
    },
    {
      "description": "canonical root references unavailable required evidence",
      "guidance": "repair; no adjudication requiring it",
      "id": "ERR-EVIDENCE-MISSING-001"
    },
    {
      "description": "same key used with different request digest",
      "guidance": "reject permanently",
      "id": "ERR-IDEMPOTENCY-CONFLICT-001"
    },
    {
      "description": "effect lease fence is not current",
      "guidance": "re-prepare under fresh lease",
      "id": "ERR-LEASE-STALE-001"
    },
    {
      "description": "operation execution failed with expected domain error",
      "guidance": "inspect error details and apply recovery guidance",
      "id": "ERR-OP-EXECUTION-FAILED-001"
    },
    {
      "description": "operation budget or deadline expired before completion",
      "guidance": "retry with higher budget or backoff",
      "id": "ERR-OP-TIMEOUT-001"
    },
    {
      "description": "plan anchor changed before commit",
      "guidance": "re-plan; never auto-commit changed intent",
      "id": "ERR-PRECONDITION-STALE-001"
    },
    {
      "description": "region/process failed to drain",
      "guidance": "block shutdown/upgrade claim; force isolation path",
      "id": "ERR-QUIESCENCE-001"
    },
    {
      "description": "semantic decision fingerprint differs from proof",
      "guidance": "block claim/release",
      "id": "ERR-REPLAY-DIVERGED-001"
    },
    {
      "description": "gaps/jitter exceed contract",
      "guidance": "degrade coverage; bounded recovery",
      "id": "ERR-STREAM-CONTINUITY-001"
    }
  ],
