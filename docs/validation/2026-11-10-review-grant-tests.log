Reproducible harness recipe (run from a checkout; use its pinned rustc):

review_repo="$(pwd)"
review_out="$(mktemp -d)"
python3 - "$review_repo" "$review_out" <<'PY'
import json
import sys
from pathlib import Path
root, out = map(Path, sys.argv[1:])
source = (root / 'crates/fss-reference/src/evidence_export.rs').read_text()
constants = [line for line in source.splitlines() if line.startswith(
    ('pub const CAP_EXPORT_PREPARE:', 'pub const MAX_PURPOSE_BYTES:'))]
assert len(constants) == 2
(out / 'export_constants.rs').write_text('\n'.join(constants) + '\n')
grant = json.dumps(str(root / 'crates/fss-reference/src/review_media/grant.rs'), ensure_ascii=False)
(out / 'harness.rs').write_text(
    '#![forbid(unsafe_code)]\n'
    'mod evidence_export { include!("export_constants.rs"); }\n'
    f'#[path = {grant}]\nmod grant;\n')
PY
rustc --edition 2024 --crate-name fss_core --crate-type rlib -C debuginfo=0 -Zthreads=1 crates/fss-core/src/lib.rs -o "$review_out/libfss_core.rlib"
rustc --edition 2024 --test -C debuginfo=0 -Zthreads=1 "$review_out/harness.rs" --extern "fss_core=$review_out/libfss_core.rlib" -o "$review_out/grant_tests"
"$review_out/grant_tests"

