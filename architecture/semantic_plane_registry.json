{
  "schema": "fss.semantic_plane_registry.v1",
  "as_of": "2026-09-01",
  "normative_adr": "docs/adr/ADR-0001-three-semantic-planes.md",
  "negative_constraint": "NEG-003",
  "doctrine": "Authority, cognition, and effect planes are type-distinct: values never convert without explicit boundary types, and cognition output can never grant effect authority.",
  "planes": {
    "ambiguous": {
      "definition": "Types that bridge multiple planes or combine source evidence with derived hypotheses; reported as findings without guessing",
      "mutation_rule": "Requires explicit boundary auditing"
    },
    "authority": {
      "definition": "Immutable observations, identities, policies, receipts, capability tokens, and canonical state",
      "mutation_rule": "Authority may only be updated via verified cryptographic receipts or canonical ledger transitions"
    },
    "cognition": {
      "definition": "Tracks, embeddings, hypotheses, rankings, model outputs, beliefs, and memories",
      "mutation_rule": "Cognition may propose but cannot directly mutate authority or perform effects"
    },
    "effect": {
      "definition": "Alerts, PTZ, retention, export, deletion, activation, and repair mutations",
      "mutation_rule": "Effects require prepared intent, capability, precondition, idempotency identity, and receipt"
    },
    "support": {
      "definition": "Typed error structures, parser helpers, and foundational codec utilities"
    }
  },
